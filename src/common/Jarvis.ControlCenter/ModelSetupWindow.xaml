<Window
    x:Class="Jarvis.ControlCenter.ModelSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Loc.Setup.Title}"
    Width="600"
    Height="520"
    MinWidth="600"
    MinHeight="520"
    MaxWidth="600"
    MaxHeight="520"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#070A0D"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    PreviewKeyDown="Window_OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A1014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D151A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#101A20" />
        <SolidColorBrush x:Key="LineBrush" Color="#20323A" />
        <SolidColorBrush x:Key="LineBrightBrush" Color="#3C5660" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EFF1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A4AC" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#60747C" />
        <SolidColorBrush x:Key="CyanBrush" Color="#55DED3" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#112B2C" />
        <SolidColorBrush x:Key="RedBrush" Color="#F07167" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#0B1115" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#071012" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="SetupSurface" BorderBrush="#2D4650" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" />
                        <TextBlock Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Setup.Header}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="38"
                        Height="32"
                        AutomationProperties.Name="{DynamicResource Loc.Setup.CloseAutomation}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe UI Symbol"
                        FontSize="13"
                        Cursor="Hand"
                        Click="CancelButton_OnClick"
                        Content="&#x00D7;" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="22" FontWeight="Light" Text="{DynamicResource Loc.Setup.Heading}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,9,0,0"
                    Foreground="{StaticResource TextMutedBrush}"
                    FontSize="12"
                    LineHeight="19"
                    Text="{DynamicResource Loc.Setup.Intro}"
                    TextWrapping="Wrap" />

                <Border
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="14,12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Setup.Model}" />
                            <TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="12" Text="gpt-5.6-sol" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Setup.Tools}" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="READ / GREP / FIND / LS / PROPOSE_EDIT / PROPOSE_PATCH / PROPOSE_CREATE_FILE / PROPOSE_CHANGE_SET" TextWrapping="Wrap" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource AmberBrush}" FontFamily="Consolas" FontSize="9" Text="{DynamicResource Loc.Setup.WriteBoundary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="{DynamicResource Loc.Setup.ApiKey}" />
                        <TextBlock
                            x:Name="CredentialState"
                            Grid.Column="1"
                            Foreground="{StaticResource CyanBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="{DynamicResource Loc.Setup.NotConfigured}" />
                    </Grid>
                    <PasswordBox
                        x:Name="ApiKeyInput"
                        Margin="0,8,0,0"
                        Height="42"
                        Padding="12,9"
                        AutomationProperties.Name="{DynamicResource Loc.Setup.KeyAutomation}"
                        Background="#081014"
                        BorderBrush="{StaticResource LineBrightBrush}"
                        BorderThickness="1"
                        CaretBrush="{StaticResource CyanBrush}"
                        Foreground="{StaticResource TextBrush}"
                        FontFamily="Consolas"
                        FontSize="12" />
                    <TextBlock
                        x:Name="ErrorMessage"
                        MinHeight="18"
                        Margin="0,7,0,0"
                        Foreground="{StaticResource RedBrush}"
                        FontSize="10"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource MonoText}"
                    Text="{DynamicResource Loc.Setup.Transport}" />
            </Grid>

            <Border
                Grid.Row="2"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="10"
                        Text="{DynamicResource Loc.Setup.ReplaceNote}" />
                    <Button
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="{DynamicResource Loc.Setup.CancelAutomation}"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Click="CancelButton_OnClick"
                        Content="{DynamicResource Loc.Common.Cancel}" />
                    <Button
                        x:Name="SaveButton"
                        Grid.Column="2"
                        AutomationProperties.Name="{DynamicResource Loc.Setup.SaveAutomation}"
                        Style="{StaticResource PrimaryDialogButton}"
                        IsDefault="True"
                        Click="SaveButton_OnClick"
                        Content="{DynamicResource Loc.Setup.Save}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

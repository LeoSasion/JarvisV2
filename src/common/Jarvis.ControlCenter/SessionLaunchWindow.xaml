<Window
    x:Class="Jarvis.ControlCenter.SessionLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Loc.Launch.Title}"
    Width="760"
    Height="730"
    MinWidth="760"
    MinHeight="730"
    MaxWidth="760"
    MaxHeight="730"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#070A0D"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    PreviewKeyDown="Window_OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A1014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D151A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#101A20" />
        <SolidColorBrush x:Key="LineBrush" Color="#20323A" />
        <SolidColorBrush x:Key="LineBrightBrush" Color="#3C5660" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EFF1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A4AC" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#60747C" />
        <SolidColorBrush x:Key="CyanBrush" Color="#55DED3" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#112B2C" />
        <SolidColorBrush x:Key="RedBrush" Color="#F07167" />
        <SolidColorBrush x:Key="RedDimBrush" Color="#352020" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#0B1115" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#071012" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style x:Key="RecentSessionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CyanDimBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#0B1115" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Opacity" Value="0.62" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="ChoiceChrome"
                            Padding="14,12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse Stroke="{StaticResource LineBrightBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="SelectionDot" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="{StaticResource CyanDimBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D4650" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" />
                        <TextBlock Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Launch.Header}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="38"
                        Height="32"
                        AutomationProperties.Name="{DynamicResource Loc.Launch.CloseAutomation}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe UI Symbol"
                        FontSize="13"
                        Cursor="Hand"
                        Click="CancelButton_OnClick"
                        Content="&#x00D7;" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,22">
                    <TextBlock FontSize="22" FontWeight="Light" Text="{DynamicResource Loc.Launch.Heading}" />
                    <TextBlock
                        Margin="0,9,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="12"
                        LineHeight="19"
                        Text="{DynamicResource Loc.Launch.Intro}"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Launch.Recent}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="10"
                                Text="{DynamicResource Loc.Launch.RecentDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource MonoText}"
                            Text="{DynamicResource Loc.Launch.Dpapi}" />
                    </Grid>
                    <Border
                        Margin="0,9,0,0"
                        Padding="7"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Grid>
                            <TextBlock
                                x:Name="RecentSessionEmpty"
                                Padding="8,9"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="11"
                                Text="{DynamicResource Loc.Launch.NoRecent}"
                                TextWrapping="Wrap" />
                            <ItemsControl x:Name="RecentSessionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,0,6"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            IsEnabled="{Binding CanResume}"
                                            Style="{StaticResource RecentSessionButton}"
                                            Tag="{Binding}"
                                            Click="RecentSessionButton_OnClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding WorkspaceName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,4,16,0"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        Text="{Binding WorkspaceRoot}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Foreground="{StaticResource CyanBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding ActionLabel}" />
                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Right"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="9"
                                                        Text="{Binding MetadataLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="{DynamicResource Loc.Launch.WorkspaceStep}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Launch.WorkspaceBoundary}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="WorkspaceInput"
                            Height="42"
                            Padding="12,9"
                            AutomationProperties.Name="{DynamicResource Loc.Launch.WorkspaceAutomation}"
                            Background="#081014"
                            BorderBrush="{StaticResource LineBrightBrush}"
                            BorderThickness="1"
                            CaretBrush="{StaticResource CyanBrush}"
                            Foreground="{StaticResource TextBrush}"
                            FontFamily="Consolas"
                            FontSize="11"
                            TextChanged="WorkspaceInput_OnTextChanged" />
                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="{DynamicResource Loc.Launch.BrowseAutomation}"
                            Style="{StaticResource DialogButton}"
                            MinWidth="94"
                            Click="BrowseButton_OnClick"
                            Content="{DynamicResource Loc.Launch.Browse}" />
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="{DynamicResource Loc.Launch.ModelStep}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Launch.ModelBoundary}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="LocalProviderOption"
                            GroupName="Provider"
                            Style="{StaticResource ProviderChoice}"
                            AutomationProperties.Name="{DynamicResource Loc.Launch.LocalAutomation}"
                            IsChecked="True">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Launch.Local}" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="{DynamicResource Loc.Launch.LocalDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="OpenAiProviderOption"
                            Grid.Column="2"
                            GroupName="Provider"
                            Style="{StaticResource ProviderChoice}"
                            AutomationProperties.Name="{DynamicResource Loc.Launch.OpenAiAutomation}">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="OpenAI Responses" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="{DynamicResource Loc.Launch.OpenAiDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border
                        Margin="0,20,0,0"
                        Padding="14,12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="AdmissionDot" Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{StaticResource TextFaintBrush}" />
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                <TextBlock x:Name="AdmissionState" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{DynamicResource Loc.Launch.Awaiting}" />
                                <TextBlock x:Name="AdmissionDetail" Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{DynamicResource Loc.Launch.AwaitingDetail}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Launch.Safety}" TextAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="{DynamicResource Loc.Launch.NoProcess}" />
                    <Button
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="{DynamicResource Loc.Launch.CancelAutomation}"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Click="CancelButton_OnClick"
                        Content="{DynamicResource Loc.Common.Cancel}" />
                    <Button
                        x:Name="StartButton"
                        Grid.Column="2"
                        AutomationProperties.Name="{DynamicResource Loc.Launch.StartAutomation}"
                        Style="{StaticResource PrimaryDialogButton}"
                        IsEnabled="False"
                        IsDefault="True"
                        Click="StartButton_OnClick"
                        Content="{DynamicResource Loc.Launch.Start}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

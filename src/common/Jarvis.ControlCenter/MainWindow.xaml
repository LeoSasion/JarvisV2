                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />
                                <Border x:Name="JarvisStage" Grid.Column="6" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Stage.Jarvis}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Stage.JarvisDetail}" />
                                    </StackPanel>
                                </Border>

<Window
    x:Class="Jarvis.ControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.ControlCenter"
    Title="{DynamicResource Loc.App.Title}"
    Width="1440"
    Height="900"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    Background="#070A0D"
    Tag="impeccable:surface-seed:32fb29e4"
    PreviewKeyDown="MainWindow_OnPreviewKeyDown"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <!--
    THESIS: One active Pi turn is a visible handoff, not an opaque chat bubble.
    The surface refuses the generic assistant dashboard and keeps ownership,
    tools, cancellation and shutdown in the same field as the conversation.
    OWN-WORLD: Matte near-black planes, one-pixel blue-gray rules, cyan only for
    active state, amber for waiting, red for faults, Segoe UI plus measured mono.
    STORY: The operator admits a workspace, hands Pi one request, watches the
    baton across the bounded tool boundary, reviews each staged edit, validates
    the repository, and lets a time-bounded owner policy continue the mission.
    FIRST VIEWPORT: Navigation left, four-stage handoff rail above a dominant
    transcript and composer, runtime inspector right, owned-runtime status below.
    FORM: Assigned structure five with passed-baton staging; seed 32fb29e4.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A1014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D151A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#101A20" />
        <SolidColorBrush x:Key="LineBrush" Color="#20323A" />
        <SolidColorBrush x:Key="LineBrightBrush" Color="#3C5660" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EFF1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A4AC" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#60747C" />
        <SolidColorBrush x:Key="CyanBrush" Color="#55DED3" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#112B2C" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B958" />
        <SolidColorBrush x:Key="AmberDimBrush" Color="#352817" />
        <SolidColorBrush x:Key="RedBrush" Color="#F07167" />
        <SolidColorBrush x:Key="RedDimBrush" Color="#352020" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#172329" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="{StaticResource CyanDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="ActionChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#0B1115" />
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#071012" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>

        <Style x:Key="OwnershipProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Height="1" Background="{TemplateBinding Background}" />
                            <Grid
                                x:Name="PART_Track"
                                Height="4"
                                Background="Transparent"
                                ClipToBounds="True">
                                <Border
                                    x:Name="PART_Indicator"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="#081014" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid
                            x:Name="NeuralScrollTrack"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <Border
                                x:Name="NeuralScrollTrackLine"
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="{StaticResource LineBrush}" />
                            <Track
                                x:Name="PART_Track"
                                Focusable="False"
                                IsDirectionReversed="True"
                                Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb
                                        x:Name="NeuralScrollThumb"
                                        MinHeight="36"
                                        Margin="1,0"
                                        Background="{TemplateBinding Foreground}"
                                        Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Background="Transparent">
                                                    <Border
                                                        x:Name="ThumbBody"
                                                        Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2" />
                                                    <Rectangle
                                                        x:Name="ThumbSignal"
                                                        Width="4"
                                                        Height="8"
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Fill="{StaticResource CyanBrush}"
                                                        Opacity="0" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource CyanBrush}" />
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource CyanBrush}" />
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                                                        <Setter TargetName="ThumbSignal" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                                                        <Setter TargetName="ThumbSignal" Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                                        <Setter TargetName="ThumbBody" Property="Width" Value="Auto" />
                                                        <Setter TargetName="ThumbBody" Property="Height" Value="4" />
                                                        <Setter TargetName="ThumbBody" Property="HorizontalAlignment" Value="Stretch" />
                                                        <Setter TargetName="ThumbBody" Property="VerticalAlignment" Value="Center" />
                                                        <Setter TargetName="ThumbSignal" Property="Width" Value="8" />
                                                        <Setter TargetName="ThumbSignal" Property="Height" Value="4" />
                                                        <Setter TargetName="ThumbSignal" Property="Margin" Value="5,0,0,0" />
                                                        <Setter TargetName="ThumbSignal" Property="HorizontalAlignment" Value="Left" />
                                                        <Setter TargetName="ThumbSignal" Property="VerticalAlignment" Value="Center" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="NeuralScrollTrackLine" Property="Width" Value="Auto" />
                                <Setter TargetName="NeuralScrollTrackLine" Property="Height" Value="1" />
                                <Setter TargetName="NeuralScrollTrackLine" Property="HorizontalAlignment" Value="Stretch" />
                                <Setter TargetName="NeuralScrollTrackLine" Property="VerticalAlignment" Value="Center" />
                                <Setter TargetName="NeuralScrollThumb" Property="MinWidth" Value="36" />
                                <Setter TargetName="NeuralScrollThumb" Property="MinHeight" Value="0" />
                                <Setter TargetName="NeuralScrollThumb" Property="Margin" Value="0,1" />
                                <Setter TargetName="NeuralScrollThumb" Property="Cursor" Value="SizeWE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D4650" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="StatusDockRow" Height="50" />
            </Grid.RowDefinitions>

            <Border
                x:Name="HeaderChrome"
                Grid.Row="0"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource CyanBrush}" StrokeThickness="1" Opacity="0.75" />
                        <Ellipse Width="15" Height="15" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" />
                        <Rectangle Width="4" Height="4" Fill="{StaticResource CyanBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold" Text="{DynamicResource Loc.Header.Product}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource MonoText}"
                            FontSize="8"
                            Text="{DynamicResource Loc.Header.Subtitle}" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Height="1"
                        Margin="26,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource LineBrush}" />

                    <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource MonoText}"
                            Text="{DynamicResource Loc.Header.RuntimePath}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource CyanBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="{DynamicResource Loc.Header.ReviewGated}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button
                            x:Name="ImmersiveModeButton"
                            AutomationProperties.Name="{DynamicResource Loc.Immersive.EnterAutomation}"
                            ToolTip="{DynamicResource Loc.Immersive.EnterTooltip}"
                            Style="{StaticResource WindowButton}"
                            Click="ImmersiveModeButton_OnClick">
                            <Viewbox Width="16" Height="16">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M1,6 L1,1 L6,1 M12,1 L17,1 L17,6 M17,12 L17,17 L12,17 M6,17 L1,17 L1,12"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Square"
                                    StrokeEndLineCap="Square" />
                            </Viewbox>
                        </Button>
                        <Button
                            AutomationProperties.Name="{DynamicResource Loc.Window.MinimizeAutomation}"
                            Style="{StaticResource WindowButton}"
                            Click="MinimizeButton_OnClick"
                            Content="&#x2212;" />
                        <Button
                            AutomationProperties.Name="{DynamicResource Loc.Window.CloseAutomation}"
                            Style="{StaticResource WindowButton}"
                            Click="CloseButton_OnClick"
                            Content="&#x00D7;" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="BodyGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WorkspaceRailColumn" Width="204" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RuntimeInspectorColumn" Width="304" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="WorkspaceRail"
                    Grid.Column="0"
                    Background="#081014"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid Margin="16,20,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Nav.Workspace}" />

                            <Border
                                Margin="0,14,0,4"
                                Padding="11,10"
                                Background="#13262A"
                                BorderBrush="{StaticResource CyanBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="01" />
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Nav.Conversation}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="02" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="{DynamicResource Loc.Nav.Runtime}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="03" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="{DynamicResource Loc.Nav.ReadTools}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="04" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="{DynamicResource Loc.Nav.SafetyGates}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="05" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="{DynamicResource Loc.Nav.Evidence}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Style="{StaticResource PanelBorder}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Nav.LocalTime}" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{StaticResource CyanBrush}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="LocalClock"
                                        Margin="0,10,0,0"
                                        FontFamily="Consolas"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        Text="00:00:00" />
                                    <TextBlock
                                        x:Name="LocalDate"
                                        Margin="0,2,0,0"
                                        Style="{StaticResource MonoText}"
                                        Text="2026.08.02" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="2,12,0,0"
                                Foreground="{StaticResource TextFaintBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{DynamicResource Loc.Nav.SafetySummary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    x:Name="ConversationWorkspace"
                    Grid.Column="1"
                    Margin="20,16,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="122" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="126" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="22" FontWeight="Light" Text="{DynamicResource Loc.Conversation.Title}" />
                            <TextBlock
                                Margin="14,5,0,0"
                                Foreground="{StaticResource CyanBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{Binding ProviderLabel}" />
                            <TextBlock
                                Margin="12,5,0,0"
                                Foreground="{StaticResource CyanBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{Binding AccessLabel}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ConversationShortcuts"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoText}"
                            Text="{DynamicResource Loc.Conversation.Shortcuts}" />
                        <Button
                            x:Name="ImmersiveExitButton"
                            Grid.Column="1"
                            Height="30"
                            MinWidth="0"
                            Padding="12,0"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="{DynamicResource Loc.Immersive.ExitAutomation}"
                            Style="{StaticResource ActionButton}"
                            Visibility="Collapsed"
                            Click="ImmersiveExitButton_OnClick"
                            Content="{DynamicResource Loc.Immersive.Exit}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="UserStage" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Stage.User}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Stage.UserDetail}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />
                                <Border x:Name="PiStage" Grid.Column="2" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Loc.Stage.Pi}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Stage.PiDetail}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />

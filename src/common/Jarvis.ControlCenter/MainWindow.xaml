                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Aborted">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{DynamicResource Loc.Turn.You}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding TurnId}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,7,0,0"
                                                        Foreground="{StaticResource TextBrush}"
                                                        FontSize="13"
                                                        LineHeight="20"
                                                        Text="{Binding UserText}"
                                                        TextWrapping="Wrap" />

                                                    <ItemsControl Grid.Row="2" Margin="0,11,0,0" ItemsSource="{Binding Tools}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Margin="0,0,0,6"
                                                                    Padding="10,8"
                                                                    Background="{StaticResource PanelAltBrush}"
                                                                    BorderBrush="{StaticResource LineBrightBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="82" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{DynamicResource Loc.Turn.SessionTool}" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" Text="{Binding ToolName}" />
                                                                            <TextBlock Margin="0,3,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                                                        <Setter Property="Text" Value="INVOCATION ADMITTED" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                                <Setter Property="Text" Value="INVOCATION IN FLIGHT" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                                <Setter Property="Text" Value="RESULT RETURNED TO PI" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                <Setter Property="Text" Value="FAILED CLOSED" />
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MonoText}" FontSize="10" Text="{Binding Status}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <ItemsControl Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding WorkspaceEdits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Margin="0,0,0,8"
                                                                    Padding="12"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                                                    <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Drifted">
                                                                                    <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Foreground="{StaticResource AmberBrush}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Text="{Binding ProposalLabel}" />
                                                                            <TextBlock Grid.Column="1" Margin="16,0,0,0" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Drifted">
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>

                                                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" Text="{Binding PathLabel}" TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding ConstraintLabel}" TextWrapping="Wrap" />

                                                                        <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding BeforeHashLabel}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding AfterHashLabel}" TextTrimming="CharacterEllipsis" />

                                                                        <ItemsControl ItemsSource="{Binding FileChanges}">
                                                                            <ItemsControl.Style>
                                                                                <Style TargetType="ItemsControl">
                                                                                    <Setter Property="Margin" Value="0,10,0,0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsChangeSet}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ItemsControl.Style>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border
                                                                                        Margin="0,0,0,9"
                                                                                        Padding="10"
                                                                                        Background="#090D10"
                                                                                        BorderBrush="{StaticResource LineBrightBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="2">
                                                                                        <StackPanel>
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Foreground="{StaticResource AmberBrush}" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" Text="{Binding FileLabel}" />
                                                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{DynamicResource Loc.Turn.OrderedWholeSet}" />
                                                                                            </Grid>
                                                                                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding RelativePath}" TextWrapping="Wrap" />
                                                                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding BeforeHashLabel}" TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding AfterHashLabel}" TextTrimming="CharacterEllipsis" />
                                                                                            <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding ReviewSegments}">
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <Grid Margin="0,0,0,7">
                                                                                                            <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                                <ColumnDefinition Width="12" />
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                            </Grid.ColumnDefinitions>
                                                                                                            <StackPanel>
                                                                                                                <TextBlock Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding OriginalLabel}" />
                                                                                                                <TextBox
                                                                                                                    AutomationProperties.Name="{Binding OriginalAutomationName}"
                                                                                                                    Margin="0,5,0,0"
                                                                                                                    MinHeight="42"
                                                                                                                    Padding="8,6"
                                                                                                                    IsReadOnly="True"
                                                                                                                    AcceptsReturn="True"
                                                                                                                    VerticalScrollBarVisibility="Disabled"
                                                                                                                    HorizontalScrollBarVisibility="Auto"
                                                                                                                    Background="#070A0C"
                                                                                                                    BorderBrush="{StaticResource LineBrush}"
                                                                                                                    BorderThickness="1"
                                                                                                                    Foreground="{StaticResource TextBrush}"
                                                                                                                    FontFamily="Consolas"
                                                                                                                    FontSize="10"
                                                                                                                    Text="{Binding OriginalText, Mode=OneWay}" />
                                                                                                            </StackPanel>
                                                                                                            <StackPanel Grid.Column="2">
                                                                                                                <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding ProposedLabel}" />
                                                                                                                <TextBox
                                                                                                                    AutomationProperties.Name="{Binding ProposedAutomationName}"
                                                                                                                    Margin="0,5,0,0"
                                                                                                                    MinHeight="42"
                                                                                                                    Padding="8,6"
                                                                                                                    IsReadOnly="True"
                                                                                                                    AcceptsReturn="True"
                                                                                                                    VerticalScrollBarVisibility="Disabled"
                                                                                                                    HorizontalScrollBarVisibility="Auto"
                                                                                                                    Background="#070A0C"
                                                                                                                    BorderBrush="{StaticResource LineBrush}"
                                                                                                                    BorderThickness="1"
                                                                                                                    Foreground="{StaticResource TextBrush}"
                                                                                                                    FontFamily="Consolas"
                                                                                                                    FontSize="10"
                                                                                                                    Text="{Binding ProposedText, Mode=OneWay}" />
                                                                                                            </StackPanel>
                                                                                                        </Grid>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ReviewSegments}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,0,0,7">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="12" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <StackPanel>
                                                                                            <TextBlock Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding OriginalLabel}" />
                                                                                            <TextBox
                                                                                                AutomationProperties.Name="{Binding OriginalAutomationName}"
                                                                                                Margin="0,5,0,0"
                                                                                                MinHeight="42"
                                                                                                Padding="8,6"
                                                                                                IsReadOnly="True"
                                                                                                AcceptsReturn="True"
                                                                                                VerticalScrollBarVisibility="Disabled"
                                                                                                HorizontalScrollBarVisibility="Auto"
                                                                                                Background="#090D10"
                                                                                                BorderBrush="{StaticResource LineBrush}"
                                                                                                BorderThickness="1"
                                                                                                Foreground="{StaticResource TextBrush}"
                                                                                                FontFamily="Consolas"
                                                                                                FontSize="10"
                                                                                                Text="{Binding OriginalText, Mode=OneWay}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Grid.Column="2">
                                                                                            <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding ProposedLabel}" />
                                                                                            <TextBox
                                                                                                AutomationProperties.Name="{Binding ProposedAutomationName}"
                                                                                                Margin="0,5,0,0"
                                                                                                MinHeight="42"
                                                                                                Padding="8,6"
                                                                                                IsReadOnly="True"
                                                                                                AcceptsReturn="True"
                                                                                                VerticalScrollBarVisibility="Disabled"
                                                                                                HorizontalScrollBarVisibility="Auto"
                                                                                                Background="#090D10"
                                                                                                BorderBrush="{StaticResource LineBrush}"
                                                                                                BorderThickness="1"
                                                                                                Foreground="{StaticResource TextBrush}"
                                                                                                FontFamily="Consolas"
                                                                                                FontSize="10"
                                                                                                Text="{Binding ProposedText, Mode=OneWay}" />
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Grid Margin="0,9,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                MaxWidth="470"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                                FontSize="10"
                                                                                LineHeight="15"
                                                                                Text="{Binding DecisionBoundaryText}"
                                                                                TextWrapping="Wrap" />
                                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                                                                                <Button
                                                                                    AutomationProperties.Name="{Binding RejectionAutomationName}"
                                                                                    Tag="{Binding ProposalId}"
                                                                                    Click="RejectWorkspaceEditButton_OnClick"
                                                                                    Content="{Binding RejectActionLabel}">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                                            <Setter Property="IsEnabled" Value="{Binding CanDecide}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DataContext.CanReviewWorkspaceEdits, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                                <Button
                                                                                    Margin="8,0,0,0"
                                                                                    AutomationProperties.Name="{Binding ApprovalAutomationName}"
                                                                                    Tag="{Binding ProposalId}"
                                                                                    Click="ApproveWorkspaceEditButton_OnClick"
                                                                                    Content="{Binding ApproveActionLabel}">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                                                                            <Setter Property="IsEnabled" Value="{Binding CanDecide}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DataContext.CanReviewWorkspaceEdits, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Grid.Row="4" Margin="0,8,0,0" Height="1" Background="{StaticResource LineBrush}" />
                                                    <Grid Grid.Row="5" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                            <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{DynamicResource Loc.Stage.Jarvis}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{StaticResource TextBrush}"
                                                            FontSize="13"
                                                            LineHeight="20"
                                                            Text="{Binding AssistantText}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource MonoText}" Text="{Binding Status}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="EmptyConversationMessage"
                                Margin="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid Width="42" Height="42" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource LineBrightBrush}" StrokeThickness="1" />
                                    <Ellipse Width="16" Height="16" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" />
                                    <Rectangle Width="4" Height="4" Fill="{StaticResource CyanBrush}" />
                                </Grid>
                                <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding EmptyStateTitle}" />
                                <TextBlock
                                    Width="420"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    LineHeight="18"
                                    Text="{Binding EmptyStateDescription}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="ResumeLatestButton"
                                        Margin="0,0,10,0"
                                        AutomationProperties.Name="{DynamicResource Loc.Presence.ResumeAutomation}"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Visibility="Collapsed"
                                        Click="ResumeLatestButton_OnClick"
                                        Content="{DynamicResource Loc.Presence.Resume}" />
                                    <Button
                                        x:Name="SessionLaunchButton"
                                        AutomationProperties.Name="{DynamicResource Loc.Empty.StartAutomation}"
                                        Style="{StaticResource PrimaryActionButton}"
                                        IsEnabled="{Binding CanLaunchSession}"
                                        Click="SessionLaunchButton_OnClick"
                                        Content="{Binding SessionLaunchActionLabel}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource MonoText}"
                                    Text="{DynamicResource Loc.Empty.AdmissionSteps}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="122" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="2"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontFamily="Consolas"
                                FontSize="9"
                                Text="{DynamicResource Loc.Composer.Mode}" />
                            <TextBox
                                x:Name="PromptInput"
                                AutomationProperties.Name="{DynamicResource Loc.Composer.Automation}"
                                AutomationProperties.HelpText="{DynamicResource Loc.Composer.Help}"
                                Grid.Row="2"
                                Margin="0,0,12,0"
                                Padding="12,10"
                                AcceptsReturn="True"
                                IsEnabled="{Binding CanSubmit}"
                                MaxLength="4096"
                                VerticalContentAlignment="Top"
                                Background="#081014"
                                BorderBrush="{StaticResource LineBrightBrush}"
                                BorderThickness="1"
                                CaretBrush="{StaticResource CyanBrush}"

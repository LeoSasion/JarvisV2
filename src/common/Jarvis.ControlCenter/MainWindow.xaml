                                FontSize="13"
                                Foreground="{StaticResource TextBrush}"
                                PreviewKeyDown="PromptInput_OnPreviewKeyDown"
                                TextWrapping="Wrap" />
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <Button
                                    AutomationProperties.Name="{DynamicResource Loc.Composer.SendAutomation}"
                                    Style="{StaticResource PrimaryActionButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="SubmitButton_OnClick"
                                    Content="{DynamicResource Loc.Composer.Send}" />
                                <Button
                                    AutomationProperties.Name="{DynamicResource Loc.Composer.CancelAutomation}"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource ActionButton}"
                                    IsEnabled="{Binding CanCancel}"
                                    Click="CancelButton_OnClick"
                                    Content="{DynamicResource Loc.Common.Cancel}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    x:Name="RuntimeInspector"
                    Grid.Column="2"
                    Background="#081014"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,18,18,16">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Inspector.Section}" />
                            <TextBlock Margin="0,8,0,0" FontSize="19" FontWeight="Light" Text="{DynamicResource Loc.Inspector.Title}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="11"
                                LineHeight="17"
                                Text="{DynamicResource Loc.Inspector.Description}"
                                TextWrapping="Wrap" />

                            <Border Margin="0,18,0,0" Style="{StaticResource PanelBorder}" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="RuntimeStatusDot" Width="7" Height="7" Margin="0,1,9,0" Fill="{StaticResource TextFaintBrush}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Inspector.Runtime}" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding PhaseLabel}" />
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Inspector.SessionBoundary}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Inspector.Provider}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding ProviderLabel}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Inspector.Access}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding AccessLabel}" />
                                </Grid>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Inspector.Workspace}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    LineHeight="16"
                                    Text="{Binding WorkspaceLabel}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Review.Section}" />
                                <Border
                                    Margin="0,9,0,0"
                                    Padding="12"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="ActiveTurn">
                                                    <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="AwaitingOwnerReview">
                                                    <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="AwaitingTrustedValidation">
                                                    <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="TrustedValidationInFlight">
                                                    <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="Interrupted">
                                                    <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="Faulted">
                                                    <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Review.OwnerPolicy}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                AutomationProperties.LiveSetting="Polite"
                                                Margin="10,0,0,0"
                                                FontFamily="Consolas"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Text="{Binding ReviewedIterationStatusLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="ActiveTurn">
                                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="AwaitingOwnerReview">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="AwaitingTrustedValidation">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="TrustedValidationInFlight">
                                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="Interrupted">
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReviewedIteration.Status}" Value="Faulted">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock
                                            AutomationProperties.LiveSetting="Polite"
                                            Margin="0,8,0,0"
                                            Foreground="{StaticResource TextBrush}"
                                            FontSize="11"
                                            LineHeight="17"
                                            Text="{Binding ReviewedIterationDetail}"
                                            TextWrapping="Wrap" />
                                        <Grid
                                            AutomationProperties.Name="{DynamicResource Loc.Review.ProgressAutomation}"
                                            AutomationProperties.LiveSetting="Polite"
                                            Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MonoText}" Text="{Binding ReviewedIterationProgressLabel}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource MonoText}" Text="{Binding ReviewedIterationReceiptLabel}" />
                                        </Grid>
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource MonoText}" Text="{Binding ReviewedIterationHeadLabel}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MonoText}" Text="{Binding ReviewedIterationExpiryLabel}" />
                                        <TextBlock
                                            Margin="0,9,0,0"
                                            Style="{StaticResource MonoText}"
                                            Foreground="{StaticResource AmberBrush}"
                                            Text="{Binding ReviewedIterationValidationProfileLabel}"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="8"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                            <TextBlock
                                                AutomationProperties.Name="{DynamicResource Loc.Review.ValidationAutomation}"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontFamily="Consolas"
                                                FontSize="9"
                                                LineHeight="14"
                                                Text="{Binding ReviewedIterationValidationCommand}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock
                                            Margin="0,9,0,0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="10"
                                            LineHeight="15"
                                            Text="{DynamicResource Loc.Review.PolicySummary}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            Margin="0,12,0,0"
                                            AutomationProperties.Name="{DynamicResource Loc.Review.StartAutomation}"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="{Binding CanStartReviewedIteration}"
                                            Click="StartReviewedIterationButton_OnClick"
                                            Content="{DynamicResource Loc.Review.Start}" />
                                        <Button
                                            Margin="0,8,0,0"
                                            AutomationProperties.Name="{DynamicResource Loc.Review.RunTestsAutomation}"
                                            IsEnabled="{Binding CanRunTrustedValidation}"
                                            Click="RunTrustedValidationButton_OnClick"
                                            Content="{DynamicResource Loc.Review.RunTests}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                    <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                AutomationProperties.Name="{DynamicResource Loc.Review.RearmAutomation}"
                                                Style="{StaticResource ActionButton}"
                                                IsEnabled="{Binding CanResumeReviewedIteration}"
                                                Click="ResumeReviewedIterationButton_OnClick"
                                                Content="{DynamicResource Loc.Review.Rearm}" />
                                            <Button
                                                Grid.Column="2"
                                                AutomationProperties.Name="{DynamicResource Loc.Review.StopAutomation}"
                                                Style="{StaticResource ActionButton}"
                                                IsEnabled="{Binding CanStopReviewedIteration}"
                                                Click="StopReviewedIterationButton_OnClick"
                                                Content="{DynamicResource Loc.Review.Stop}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Tools.Section}" />
                                <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding ActiveTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Consolas" FontSize="10" Text="{Binding ToolName}" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Text="{DynamicResource Loc.Tools.Permitted}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AmberBrush}" FontSize="10" Text="{DynamicResource Loc.Tools.Writes}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource RedBrush}" FontSize="10" Text="{DynamicResource Loc.Tools.Locked}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="{DynamicResource Loc.Tools.Continuation}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Transport.Section}" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Transport.Broker}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding BrokerLabel}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Transport.Checkpoint}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding CheckpointLabel}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="{DynamicResource Loc.Transport.Credential}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding CredentialLabel}" TextWrapping="Wrap" />
                                <Button
                                    Margin="0,12,0,0"
                                    AutomationProperties.Name="{DynamicResource Loc.Model.ConfigureAutomation}"
                                    Style="{StaticResource ActionButton}"
                                    Click="ModelSetupButton_OnClick"
                                    Content="{DynamicResource Loc.Model.Configure}" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Presence.Section}" />
                                <TextBlock
                                    x:Name="StartupPresenceStatus"
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="{DynamicResource Loc.Presence.Unknown}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="10"
                                    LineHeight="15"
                                    Text="{DynamicResource Loc.Presence.Description}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="StartupRegistrationButton"
                                    Margin="0,12,0,0"
                                    AutomationProperties.Name="{DynamicResource Loc.Presence.ToggleAutomation}"
                                    Style="{StaticResource ActionButton}"
                                    IsEnabled="False"
                                    Click="StartupRegistrationButton_OnClick"
                                    Content="{DynamicResource Loc.Presence.Enable}" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Language.Section}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource CyanBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="{DynamicResource Loc.Language.Authority}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    FontSize="11"
                                    Text="{DynamicResource Loc.Language.Current}" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="10"
                                    LineHeight="15"
                                    Text="{DynamicResource Loc.Language.Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Margin="0,20,0,0"
                                Padding="12"
                                Background="{StaticResource CyanDimBrush}"
                                BorderBrush="{StaticResource LineBrightBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{DynamicResource Loc.Shutdown.Label}" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource TextBrush}" FontSize="11" Text="{Binding ShutdownLabel}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        FontSize="10"
                                        LineHeight="15"
                                        Text="{DynamicResource Loc.Shutdown.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border
                x:Name="StatusDock"
                Grid.Row="2"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="204" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource Loc.Footer.Runtime}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoText}" FontSize="10" Text="{DynamicResource Loc.Footer.Safety}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Padding="11,6"
                        Background="#0A1216"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="&#x203A;" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource MonoText}" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="#10191D"
                        BorderBrush="{StaticResource LineBrightBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{StaticResource CyanBrush}" />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding PhaseLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <local:HandoffConstellationLayer
                x:Name="HandoffConstellationVfx"
                Grid.RowSpan="3"
                Panel.ZIndex="40"
                Focusable="False"
                IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>

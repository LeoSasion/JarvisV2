<Window
    x:Class="Jarvis.ControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JarvisV2 Control Center"
    Width="1440"
    Height="900"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    Background="#070A0D"
    Tag="impeccable:surface-seed:32fb29e4"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <!--
    THESIS: One active Pi turn is a visible handoff, not an opaque chat bubble.
    The surface refuses the generic assistant dashboard and keeps ownership,
    tools, cancellation and shutdown in the same field as the conversation.
    OWN-WORLD: Matte near-black planes, one-pixel blue-gray rules, cyan only for
    active state, amber for waiting, red for faults, Segoe UI plus measured mono.
    STORY: The operator admits a workspace, hands Pi one request, watches the
    baton across the bounded tool boundary, reviews any staged edit, receives
    Jarvis, then regains control.
    FIRST VIEWPORT: Navigation left, four-stage handoff rail above a dominant
    transcript and composer, runtime inspector right, owned-runtime status below.
    FORM: Assigned structure five with passed-baton staging; seed 32fb29e4.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A1014" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D151A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#101A20" />
        <SolidColorBrush x:Key="LineBrush" Color="#20323A" />
        <SolidColorBrush x:Key="LineBrightBrush" Color="#3C5660" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EFF1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#91A4AC" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#60747C" />
        <SolidColorBrush x:Key="CyanBrush" Color="#55DED3" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#112B2C" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B958" />
        <SolidColorBrush x:Key="AmberDimBrush" Color="#352817" />
        <SolidColorBrush x:Key="RedBrush" Color="#F07167" />
        <SolidColorBrush x:Key="RedDimBrush" Color="#352020" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#172329" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="{StaticResource CyanDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="ActionChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#0B1115" />
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#071012" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>

        <Style x:Key="OwnershipProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Height="1" Background="{TemplateBinding Background}" />
                            <Grid
                                x:Name="PART_Track"
                                Height="4"
                                Background="Transparent"
                                ClipToBounds="True">
                                <Border
                                    x:Name="PART_Indicator"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D4650" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource CyanBrush}" StrokeThickness="1" Opacity="0.75" />
                        <Ellipse Width="15" Height="15" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" />
                        <Rectangle Width="4" Height="4" Fill="{StaticResource CyanBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold" Text="JARVIS V2" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource MonoText}"
                            FontSize="8"
                            Text="PI DESKTOP / CONTROL CENTER" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Height="1"
                        Margin="26,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource LineBrush}" />

                    <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource MonoText}"
                            Text="CONTROL CENTER / LOCAL RUNTIME" />
                        <TextBlock
                            Margin="0,2,0,0"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource CyanBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="REVIEW-GATED PI TOOLS" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button
                            AutomationProperties.Name="Minimize JarvisV2"
                            Style="{StaticResource WindowButton}"
                            Click="MinimizeButton_OnClick"
                            Content="&#x2212;" />
                        <Button
                            AutomationProperties.Name="Close JarvisV2"
                            Style="{StaticResource WindowButton}"
                            Click="CloseButton_OnClick"
                            Content="&#x00D7;" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="304" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="#081014"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid Margin="16,20,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Workspace" />

                            <Border
                                Margin="0,14,0,4"
                                Padding="11,10"
                                Background="#13262A"
                                BorderBrush="{StaticResource CyanBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="01" />
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="Conversation" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="02" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="Runtime" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="03" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="Read tools" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="04" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="Safety gates" />
                                </Grid>
                            </Border>

                            <Border Margin="0,2" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="05" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="Evidence" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Style="{StaticResource PanelBorder}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="Local time" />
                                        <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{StaticResource CyanBrush}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="LocalClock"
                                        Margin="0,10,0,0"
                                        FontFamily="Consolas"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        Text="00:00:00" />
                                    <TextBlock
                                        x:Name="LocalDate"
                                        Margin="0,2,0,0"
                                        Style="{StaticResource MonoText}"
                                        Text="2026.08.02" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="2,12,0,0"
                                Foreground="{StaticResource TextFaintBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="PI AGENT // 0.82.1&#x0a;TOOLS // READ + PROPOSE&#x0a;SHELL // LOCKED" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="20,16,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="122" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="108" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Light" Text="Conversation" />
                            <TextBlock
                                Margin="14,5,0,0"
                                Foreground="{StaticResource CyanBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{Binding ProviderLabel}" />
                            <TextBlock
                                Margin="12,5,0,0"
                                Foreground="{StaticResource CyanBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="{Binding AccessLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoText}"
                            Text="CTRL+ENTER / SEND    ESC / CANCEL" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="UserStage" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="USER" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="REQUEST ORIGIN" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />
                                <Border x:Name="PiStage" Grid.Column="2" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="PI RUNTIME" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="SESSION / BROKER" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />
                                <Border x:Name="ToolStage" Grid.Column="4" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="READ TOOL" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="READ / GREP / FIND / LS / PROPOSE_EDIT" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" FontSize="18" Text="&#x203A;" />
                                <Border x:Name="JarvisStage" Grid.Column="6" Style="{StaticResource PanelBorder}" Background="{StaticResource PanelAltBrush}" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="JARVIS" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MonoText}" Text="STREAMED RESPONSE" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="2,8,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MonoText}" Text="OWNERSHIP" />
                                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ProgressBar
                                        x:Name="OwnershipProgress"
                                        AutomationProperties.Name="Active turn ownership progress"
                                        Minimum="0"
                                        Maximum="3"
                                        Style="{StaticResource OwnershipProgressStyle}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MonoText}"
                                        FontSize="10"
                                        Text="{Binding HandoffLabel}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,12" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <ScrollViewer
                                x:Name="TranscriptScroll"
                                Padding="14,6,10,10"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Turns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,8,0,0"
                                                Padding="13"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Aborted">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="YOU" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding TurnId}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,7,0,0"
                                                        Foreground="{StaticResource TextBrush}"
                                                        FontSize="13"
                                                        LineHeight="20"
                                                        Text="{Binding UserText}"
                                                        TextWrapping="Wrap" />

                                                    <ItemsControl Grid.Row="2" Margin="0,11,0,0" ItemsSource="{Binding Tools}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Margin="0,0,0,6"
                                                                    Padding="10,8"
                                                                    Background="{StaticResource PanelAltBrush}"
                                                                    BorderBrush="{StaticResource LineBrightBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="82" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="SESSION TOOL" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" Text="{Binding ToolName}" />
                                                                            <TextBlock Margin="0,3,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                                                        <Setter Property="Text" Value="INVOCATION ADMITTED" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                                <Setter Property="Text" Value="INVOCATION IN FLIGHT" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                                <Setter Property="Text" Value="RESULT RETURNED TO PI" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                <Setter Property="Text" Value="FAILED CLOSED" />
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MonoText}" FontSize="10" Text="{Binding Status}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <ItemsControl Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding WorkspaceEdits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Margin="0,0,0,8"
                                                                    Padding="12"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource AmberDimBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                                                    <Setter Property="Background" Value="{StaticResource CyanDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Drifted">
                                                                                    <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                    <Setter Property="Background" Value="{StaticResource RedDimBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Foreground="{StaticResource AmberBrush}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Text="WORKSPACE EDIT PROPOSAL" />
                                                                            <TextBlock Grid.Column="1" Margin="16,0,0,0" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Applied">
                                                                                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Drifted">
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>

                                                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" Text="{Binding RelativePath}" TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="EXISTING UTF-8 FILE / EXACT UNIQUE MATCH / ONE-SHOT BEFORE HASH" />

                                                                        <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding BeforeHashLabel}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="9" Text="{Binding AfterHashLabel}" TextTrimming="CharacterEllipsis" />

                                                                        <Grid Margin="0,11,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontSize="9" Text="REMOVE / EXACT TEXT" />
                                                                                <TextBox
                                                                                    Margin="0,5,0,0"
                                                                                    MinHeight="54"
                                                                                    MaxHeight="130"
                                                                                    Padding="8,6"
                                                                                    IsReadOnly="True"
                                                                                    AcceptsReturn="True"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    HorizontalScrollBarVisibility="Auto"
                                                                                    Background="#090D10"
                                                                                    BorderBrush="{StaticResource LineBrush}"
                                                                                    BorderThickness="1"
                                                                                    Foreground="{StaticResource TextBrush}"
                                                                                    FontFamily="Consolas"
                                                                                    FontSize="10"
                                                                                    Text="{Binding OldText, Mode=OneWay}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2">
                                                                                <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="9" Text="ADD / REPLACEMENT TEXT" />
                                                                                <TextBox
                                                                                    Margin="0,5,0,0"
                                                                                    MinHeight="54"
                                                                                    MaxHeight="130"
                                                                                    Padding="8,6"
                                                                                    IsReadOnly="True"
                                                                                    AcceptsReturn="True"
                                                                                    VerticalScrollBarVisibility="Auto"
                                                                                    HorizontalScrollBarVisibility="Auto"
                                                                                    Background="#090D10"
                                                                                    BorderBrush="{StaticResource LineBrush}"
                                                                                    BorderThickness="1"
                                                                                    Foreground="{StaticResource TextBrush}"
                                                                                    FontFamily="Consolas"
                                                                                    FontSize="10"
                                                                                    Text="{Binding NewText, Mode=OneWay}" />
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <Grid Margin="0,12,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                MaxWidth="470"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                                FontSize="10"
                                                                                LineHeight="15"
                                                                                Text="Pi cannot press these controls. Reject performs no write; Approve Once rechecks the exact file hash immediately before commit."
                                                                                TextWrapping="Wrap" />
                                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                                                                                <Button
                                                                                    AutomationProperties.Name="Reject workspace edit without writing"
                                                                                    Tag="{Binding ProposalId}"
                                                                                    Click="RejectWorkspaceEditButton_OnClick"
                                                                                    Content="REJECT">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                                            <Setter Property="IsEnabled" Value="{Binding CanDecide}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DataContext.CanReviewWorkspaceEdits, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                                <Button
                                                                                    Margin="8,0,0,0"
                                                                                    AutomationProperties.Name="Approve workspace edit once"
                                                                                    Tag="{Binding ProposalId}"
                                                                                    Click="ApproveWorkspaceEditButton_OnClick"
                                                                                    Content="APPROVE ONCE">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                                                                            <Setter Property="IsEnabled" Value="{Binding CanDecide}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding DataContext.CanReviewWorkspaceEdits, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Grid.Row="4" Margin="0,8,0,0" Height="1" Background="{StaticResource LineBrush}" />
                                                    <Grid Grid.Row="5" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="JARVIS" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{StaticResource TextBrush}"
                                                            FontSize="13"
                                                            LineHeight="20"
                                                            Text="{Binding AssistantText}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource MonoText}" Text="{Binding Status}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="EmptyConversationMessage"
                                Margin="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid Width="42" Height="42" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource LineBrightBrush}" StrokeThickness="1" />
                                    <Ellipse Width="16" Height="16" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" />
                                    <Rectangle Width="4" Height="4" Fill="{StaticResource CyanBrush}" />
                                </Grid>
                                <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding EmptyStateTitle}" />
                                <TextBlock
                                    Width="420"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    LineHeight="18"
                                    Text="{Binding EmptyStateDescription}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="SessionLaunchButton"
                                    Margin="0,18,0,0"
                                    AutomationProperties.Name="Start Pi workspace session"
                                    Style="{StaticResource PrimaryActionButton}"
                                    IsEnabled="{Binding CanLaunchSession}"
                                    Click="SessionLaunchButton_OnClick"
                                    Content="{Binding SessionLaunchActionLabel}" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource MonoText}"
                                    Text="1 WORKSPACE  /  2 PROVIDER  /  3 ADMISSION" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="106" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PromptInput"
                                AutomationProperties.Name="Message Jarvis"
                                Margin="0,0,12,0"
                                Padding="12,10"
                                AcceptsReturn="True"
                                IsEnabled="{Binding CanSubmit}"
                                MaxLength="4096"
                                VerticalContentAlignment="Top"
                                Background="#081014"
                                BorderBrush="{StaticResource LineBrightBrush}"
                                BorderThickness="1"
                                CaretBrush="{StaticResource CyanBrush}"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="{StaticResource TextBrush}"
                                PreviewKeyDown="PromptInput_OnPreviewKeyDown"
                                TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1">
                                <Button
                                    AutomationProperties.Name="Send message"
                                    Style="{StaticResource PrimaryActionButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="SubmitButton_OnClick"
                                    Content="SEND" />
                                <Button
                                    AutomationProperties.Name="Cancel active turn"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource ActionButton}"
                                    IsEnabled="{Binding CanCancel}"
                                    Click="CancelButton_OnClick"
                                    Content="CANCEL" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Column="2"
                    Background="#081014"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,18,18,16">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Runtime inspector" />
                            <TextBlock Margin="0,8,0,0" FontSize="19" FontWeight="Light" Text="Pi conversation host" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="11"
                                LineHeight="17"
                                Text="One desktop-owned broker, sidecar, admitted workspace and encrypted checkpoint."
                                TextWrapping="Wrap" />

                            <Border Margin="0,18,0,0" Style="{StaticResource PanelBorder}" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="RuntimeStatusDot" Width="7" Height="7" Margin="0,1,9,0" Fill="{StaticResource TextFaintBrush}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="RUNTIME" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding PhaseLabel}" />
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Session boundary" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="PROVIDER" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding ProviderLabel}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MonoText}" Text="ACCESS" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding AccessLabel}" />
                                </Grid>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="WORKSPACE" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    LineHeight="16"
                                    Text="{Binding WorkspaceLabel}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Active tools" />
                                <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding ActiveTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Consolas" FontSize="10" Text="{Binding ToolName}" />
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextFaintBrush}" FontSize="10" Text="Permitted: read, grep, find, ls, propose_edit" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AmberBrush}" FontSize="10" Text="Writes: desktop-owner approval only" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource RedBrush}" FontSize="10" Text="Shell / direct edit / unattended approval: locked" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,20,0,0" Height="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Persistence and transport" />
                                <TextBlock Margin="0,9,0,0" Style="{StaticResource MonoText}" Text="BROKER" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding BrokerLabel}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="CHECKPOINT" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding CheckpointLabel}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MonoText}" Text="CREDENTIAL POSTURE" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding CredentialLabel}" TextWrapping="Wrap" />
                                <Button
                                    Margin="0,12,0,0"
                                    AutomationProperties.Name="Configure OpenAI model connection"
                                    Style="{StaticResource ActionButton}"
                                    Click="ModelSetupButton_OnClick"
                                    Content="CONFIGURE OPENAI" />
                            </StackPanel>

                            <Border
                                Margin="0,20,0,0"
                                Padding="12"
                                Background="{StaticResource CyanDimBrush}"
                                BorderBrush="{StaticResource LineBrightBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="SAFE SHUTDOWN" />
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource TextBrush}" FontSize="11" Text="{Binding ShutdownLabel}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        FontSize="10"
                                        LineHeight="15"
                                        Text="Closing this window quiesces submissions, cancels an active turn, flushes the DPAPI checkpoint, then releases the owned sidecar and broker."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Background="#081014"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="204" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Pi desktop runtime" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MonoText}" FontSize="10" Text="NO SHELL INJECTION / NO UNREVIEWED WRITES" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Padding="11,6"
                        Background="#0A1216"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="10" Text="&#x203A;" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource MonoText}" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Background="#10191D"
                        BorderBrush="{StaticResource LineBrightBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{StaticResource CyanBrush}" />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="10" Text="{Binding PhaseLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-control-center</AssemblyName>
    <RootNamespace>Jarvis.ControlCenter</RootNamespace>
    <StartupObject>Jarvis.ControlCenter.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <ProjectReference
      Include="..\Jarvis.DesktopPresence\Jarvis.DesktopPresence.csproj" />
    <ProjectReference
      Include="..\Jarvis.PiAgentHost\Jarvis.PiAgentHost.csproj" />
    <ProjectReference
      Include="..\Jarvis.VisualEffects\Jarvis.VisualEffects.csproj" />
  </ItemGroup>

</Project>

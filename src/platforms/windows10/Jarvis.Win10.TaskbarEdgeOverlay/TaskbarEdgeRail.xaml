<UserControl
    x:Class="Jarvis.Win10.TaskbarEdgeOverlay.TaskbarEdgeRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.TaskbarEdgeOverlay"
    Height="8"
    Background="Transparent"
    Focusable="False"
    IsHitTestVisible="False">

    <Grid Background="Transparent">
        <Rectangle
            x:Name="EdgeLine"
            Height="1"
            VerticalAlignment="Top"
            Opacity="0.28" />

        <Grid
            Width="236"
            Height="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Path
                x:Name="SignalLine"
                Data="{x:Static local:TaskbarEdgeVectorModel.SignalLineGeometry}"
                StrokeThickness="1" />
            <Path
                x:Name="PulseGlow"
                Data="{x:Static local:TaskbarEdgeVectorModel.PulseGeometry}"
                Fill="Transparent"
                StrokeThickness="2"
                Opacity="0.48">
                <Path.Effect>
                    <BlurEffect
                        KernelType="Gaussian"
                        Radius="3"
                        RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <Path
                x:Name="PulseCore"
                Data="{x:Static local:TaskbarEdgeVectorModel.PulseGeometry}"
                Fill="Transparent"
                StrokeThickness="1" />
            <Ellipse
                x:Name="PulsePoint"
                Width="2.5"
                Height="2.5"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>

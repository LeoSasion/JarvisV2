<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-win10-neural-void-preview</AssemblyName>
    <RootNamespace>Jarvis.Win10.NeuralVoidPreview</RootNamespace>
    <StartupObject>Jarvis.Win10.NeuralVoidPreview.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\..\common\Jarvis.VisualEffects\Jarvis.VisualEffects.csproj" />
    <ProjectReference
      Include="..\Jarvis.Win10.RgbThemeModel\Jarvis.Win10.RgbThemeModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\BarlowCondensed-Regular.ttf" />
    <Resource Include="Assets\Fonts\BarlowCondensed-Medium.ttf" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<UserControl
    x:Class="Jarvis.Win10.NeuralVoidPreview.DesktopShellSurface"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.NeuralVoidPreview"
    Width="1600"
    Height="900"
    Background="#000000"
    Focusable="True"
    Loaded="Surface_OnLoaded"
    Unloaded="Surface_OnUnloaded"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <FontFamily x:Key="DisplayFont">./Assets/Fonts/#Barlow Condensed</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <SolidColorBrush x:Key="CanvasBrush" Color="#000000" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4EF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7A1" />
        <SolidColorBrush x:Key="PrimaryRuleBrush" Color="#C2C2BE" />
        <SolidColorBrush x:Key="SecondaryRuleBrush" Color="#626562" />
        <SolidColorBrush x:Key="QuietRuleBrush" Color="#303230" />

        <CollectionViewSource
            x:Key="LayoutDefinitionsView"
            Source="{x:Static local:LayoutCatalog.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PaneCount" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="FocusFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusFrame" Property="Background" Value="#090909" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=Root}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FocusFrame" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopShortcutButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="170" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ExplorerActionButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="88" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LayoutOptionItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="{x:Static local:DesktopShellSurface.LayoutItemHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding AutomationName}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#090909" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemFrame" Property="BorderBrush" Value="{StaticResource SecondaryRuleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayoutRailListStyle" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer
                            Padding="0"
                            Focusable="False"
                            CanContentScroll="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsPresenter
                                Margin="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskbarButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="98" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FileRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource QuietRuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="DesktopCanvas" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
        <Canvas x:Name="DesktopIconList" Panel.ZIndex="1">
            <Button
                x:Name="ThisPcShortcutButton"
                Canvas.Left="198"
                Canvas.Top="104"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="THIS PC"
                AutomationProperties.Name="This PC">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Viewbox Width="98" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="72" Height="72">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,3 L 68,3 L 68,54 L 4,54 Z M 10,64 L 62,64 M 25,54 L 25,67 M 47,54 L 47,67" />
                            <Rectangle Canvas.Left="60" Canvas.Top="9" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="THIS PC" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="104"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="PROJECTS"
                AutomationProperties.Name="Projects">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,9 L 28,9 L 35,16 L 70,16 L 70,55 L 4,55 Z" />
                            <Rectangle Canvas.Left="61" Canvas.Top="20" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="PROJECTS" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="198"
                Canvas.Top="300"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="TERMINAL"
                AutomationProperties.Name="Terminal">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="98" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="68" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,4 L 64,4 L 64,56 L 4,56 Z M 15,21 L 27,30 L 15,39 M 31,40 L 47,40" />
                            <Rectangle Canvas.Left="57" Canvas.Top="9" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="TERMINAL" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="300"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="ARCHIVE"
                AutomationProperties.Name="Archive">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,20 L 14,6 L 60,6 L 70,20 L 70,56 L 4,56 Z M 4,20 L 70,20 M 29,26 L 45,26 L 45,31 L 29,31 Z" />
                            <Rectangle Canvas.Left="33" Canvas.Top="36" Width="9" Height="7" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="ARCHIVE" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="198"
                Canvas.Top="494"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="NETWORK"
                AutomationProperties.Name="Network">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="72" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 12,7 L 27,7 L 27,22 L 12,22 Z M 45,7 L 60,7 L 60,22 L 45,22 Z M 29,39 L 44,39 L 44,54 L 29,54 Z M 19,22 L 19,31 L 52,31 L 52,22 M 36,31 L 36,39" />
                            <Rectangle Canvas.Left="33" Canvas.Top="27" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="NETWORK" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="494"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="CONFIG"
                AutomationProperties.Name="Configuration">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="66">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 37,3 L 66,20 L 66,46 L 37,63 L 8,46 L 8,20 Z M 37,14 L 56,25 L 56,41 L 37,52 L 18,41 L 18,25 Z" />
                            <Ellipse Canvas.Left="33" Canvas.Top="29" Width="8" Height="8" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="CONFIG" />
                </Grid>
            </Button>
        </Canvas>

        <Border
            x:Name="ExplorerWindow"
            Canvas.Left="596"
            Canvas.Top="63"
            Width="930"
            Height="667"
            Panel.ZIndex="5"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource PrimaryRuleBrush}"
            BorderThickness="2"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="90" />
                    <RowDefinition Height="390" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ExplorerTitleBar"
                    Grid.Row="0"
                    BorderBrush="{StaticResource SecondaryRuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="ExplorerTitleBar_OnMouseLeftButtonDown"
                    MouseMove="ExplorerTitleBar_OnMouseMove"
                    MouseLeftButtonUp="ExplorerTitleBar_OnMouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Path Width="19" Height="15" Margin="0,0,12,0" Stroke="{Binding AccentBrush, ElementName=Root}" StrokeThickness="1.5" Data="M 1,3 L 8,3 L 11,6 L 18,6 L 18,14 L 1,14 Z" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="JARVIS2 / FILE EXPLORER" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ExplorerMinimizeButton" Style="{StaticResource WindowControlButton}" Click="ExplorerMinimizeButton_OnClick" AutomationProperties.Name="Minimize Explorer">
                                <Path Width="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Data="M 0,1 L 16,1" />
                            </Button>
                            <Button x:Name="ExplorerMaximizeButton" Style="{StaticResource WindowControlButton}" Click="ExplorerMaximizeButton_OnClick" AutomationProperties.Name="Maximize Explorer">
                                <Rectangle Width="15" Height="15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" />
                            </Button>
                            <Button x:Name="ExplorerCloseButton" Style="{StaticResource WindowControlButton}" Click="ExplorerCloseButton_OnClick" AutomationProperties.Name="Close Explorer">
                                <Path Width="16" Height="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 1,1 L 15,15 M 15,1 L 1,15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource SecondaryRuleBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="106" /><ColumnDefinition Width="2" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Width="34" Height="34" Style="{StaticResource BareButton}" Click="ExplorerBackButton_OnClick" AutomationProperties.Name="Back">
                                <Path Width="16" Height="13" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Data="M 13,1 L 4,7 L 13,13 M 4,7 L 16,7" />
                            </Button>
                            <Button Width="34" Height="34" Style="{StaticResource BareButton}" Click="ExplorerForwardButton_OnClick" AutomationProperties.Name="Forward">
                                <Path Width="16" Height="13" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Data="M 3,1 L 12,7 L 3,13 M 12,7 L 0,7" />
                            </Button>
                            <Button Width="34" Height="34" Style="{StaticResource BareButton}" Click="ExplorerUpButton_OnClick" AutomationProperties.Name="Up one level">
                                <Path Width="15" Height="17" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 1,8 L 8,1 L 15,8 M 8,1 L 8,17" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="1" Width="2" Height="24" VerticalAlignment="Center" Background="{Binding AccentBrush, ElementName=Root}" />
                        <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="THIS PC  /  NEURAL STORAGE  /  DOCUMENTS" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource SecondaryRuleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource ExplorerActionButton}" Click="ExplorerOpenButton_OnClick" AutomationProperties.Name="Open selected item">
                            <StackPanel>
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center">
                                    <Canvas Width="36" Height="36"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Data="M 5,4 L 31,4 L 31,32 L 5,32 Z M 13,18 L 35,18 M 28,11 L 35,18 L 28,25" /></Canvas>
                                </Viewbox>
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="OPEN" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExplorerActionButton}" Click="ExplorerRenameButton_OnClick" AutomationProperties.Name="Rename selected item">
                            <StackPanel>
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center"><Canvas Width="36" Height="36"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Data="M 5,29 L 10,18 L 27,1 L 35,9 L 18,26 L 5,29 Z M 10,18 L 18,26 M 4,34 L 31,34" /></Canvas></Viewbox>
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="RENAME" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExplorerActionButton}" Click="ExplorerAccessButton_OnClick" AutomationProperties.Name="Access settings">
                            <StackPanel>
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center"><Canvas Width="36" Height="36"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Data="M 9,34 L 9,18 L 18,9 M 18,9 A 7,7 0 1 1 25,16 M 23,21 L 23,34 M 30,26 L 34,26 L 34,33 L 30,33" /></Canvas></Viewbox>
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="ACCESS" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExplorerActionButton}" Click="ExplorerNewFolderButton_OnClick" AutomationProperties.Name="Create folder">
                            <StackPanel>
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center"><Canvas Width="36" Height="36"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Data="M 4,4 L 32,4 L 32,32 L 4,32 Z M 18,11 L 18,25 M 11,18 L 25,18" /><Rectangle Canvas.Left="29" Canvas.Top="5" Width="5" Height="5" Fill="{Binding AccentBrush, ElementName=Root}" /></Canvas></Viewbox>
                                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="NEW FOLDER" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="286" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="34,26,28,22">
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14" Text="FOLDER" />
                            <Border Margin="0,9,0,0" Width="26" Height="2" HorizontalAlignment="Left" Background="{Binding AccentBrush, ElementName=Root}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="190" /><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Viewbox Width="150" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="150" Height="128">
                                    <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 6,17 L 51,17 L 64,29 L 144,29 L 144,122 L 6,122 Z" />
                                    <Rectangle Canvas.Left="121" Canvas.Top="40" Width="16" Height="16" Fill="{Binding AccentBrush, ElementName=Root}" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="36" Text="DOCUMENTS">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="1.1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Grid Margin="0,4,0,0"><Border Height="2" Background="{Binding AccentBrush, ElementName=Root}" /><Rectangle Width="6" Height="6" HorizontalAlignment="Right" Stroke="{Binding AccentBrush, ElementName=Root}" StrokeThickness="1" Fill="{StaticResource CanvasBrush}" /></Grid>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Margin="0,16,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="6 ITEMS" />
                        </Grid>
                    </Grid>
                    <Border Grid.Column="1" Background="{StaticResource SecondaryRuleBrush}" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="54" /><RowDefinition Height="54" /><RowDefinition Height="54" /><RowDefinition Height="54" /><RowDefinition Height="54" /><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource FileRow}">
                            <Grid Margin="28,0,24,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="NAME" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="TYPE" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="MODIFIED" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource FileRow}"><Grid Margin="24,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions><Path Width="25" Height="31" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 3,1 L 18,1 L 25,8 L 25,30 L 3,30 Z M 18,1 L 18,8 L 25,8 M 8,14 L 20,14 M 8,19 L 20,19 M 8,24 L 20,24" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="PROJECT_BRIEF_0826.DOCX" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="DOCX" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="2026-08-06 09:14" /><Rectangle Grid.Column="4" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" /></Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource FileRow}"><Grid Margin="24,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><Path Width="25" Height="31" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 3,1 L 18,1 L 25,8 L 25,30 L 3,30 Z M 18,1 L 18,8 L 25,8 M 7,23 C 13,20 16,10 13,10 C 10,10 11,20 21,24" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="SPECIFICATIONS_V2.PDF" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="PDF" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="2026-08-05 16:42" /></Grid></Border>
                        <Border Grid.Row="3" Style="{StaticResource FileRow}"><Grid Margin="24,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><Path Width="25" Height="31" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 3,1 L 18,1 L 25,8 L 25,30 L 3,30 Z M 18,1 L 18,8 L 25,8 M 8,16 L 18,16 M 8,22 L 18,22" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="REPORT_DRAFT.PPTX" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="PPTX" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="2026-08-05 11:30" /></Grid></Border>

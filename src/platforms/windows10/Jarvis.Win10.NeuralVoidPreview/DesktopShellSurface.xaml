        <Grid
            x:Name="LayoutRailHitRegion"
            Canvas.Left="0"
            Canvas.Top="0"
            Width="126"
            Height="800"
            Panel.ZIndex="20"
            Background="Transparent"
            PreviewMouseLeftButtonDown="LayoutRailRegion_OnPreviewMouseLeftButtonDown"
            MouseLeave="LayoutRailRegion_OnMouseLeave">
            <Border
                x:Name="LayoutAxisUpper"
                Width="2"
                Height="752"
                Margin="124,48,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{StaticResource PrimaryRuleBrush}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,1">
                <Border.RenderTransform><ScaleTransform x:Name="LayoutAxisScale" ScaleY="1" /></Border.RenderTransform>
            </Border>
            <Grid
                x:Name="LayoutRailPanel"
                Width="126"
                Height="660"
                Margin="0,70,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="1"
                Visibility="Visible">
                <Border
                    x:Name="LayoutRailViewport"
                    Width="86"
                    Height="{x:Static local:DesktopShellSurface.LayoutViewportHeight}"
                    Margin="20,52,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    ClipToBounds="True">
                    <ListBox
                        x:Name="LayoutRailList"
                        Width="86"
                        Height="{x:Static local:DesktopShellSurface.LayoutViewportHeight}"
                        Margin="0"
                        Padding="0"
                        Style="{StaticResource LayoutRailListStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Source={StaticResource LayoutDefinitionsView}}"
                        ItemContainerStyle="{StaticResource LayoutOptionItem}"
                        SelectedValuePath="Preset"
                        SelectionMode="Single"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="False"
                        PreviewMouseLeftButtonUp="LayoutRailPanel_OnPreviewMouseLeftButtonUp"
                        PreviewKeyDown="LayoutRailPanel_OnPreviewKeyDown"
                        PreviewMouseWheel="LayoutRailList_OnPreviewMouseWheel"
                        AutomationProperties.HelpText="The rail remains visible. Feathered edges indicate more layouts. Pointer distance above or below the rail center controls scroll speed; arrow keys, Home, End, and the wheel remain available.">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <!--
                                PERMANENT LAYOUT-AXIS INVARIANT:
                                GroupItem must add no horizontal chrome or indentation.
                                Every 70x42 rail glyph and CurrentLayoutGlyph must
                                occupy x=28..98 on the shared x=63 centerline.
                                -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel Margin="0">
                                                        <ContentPresenter
                                                            Margin="0"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                                        <ItemsPresenter Margin="0" />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Height="12" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LayoutDefinition}">
                                <local:LayoutGlyph
                                    Width="{x:Static local:DesktopShellSurface.LayoutGlyphWidth}"
                                    Height="{x:Static local:DesktopShellSurface.LayoutGlyphHeight}"
                                    IsHitTestVisible="False"
                                    Preset="{Binding Preset}"
                                    IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                    Stroke="{StaticResource TextBrush}"
                                    Accent="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopShellSurface}}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>


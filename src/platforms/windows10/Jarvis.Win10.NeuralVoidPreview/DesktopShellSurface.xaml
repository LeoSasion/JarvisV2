<UserControl
    x:Class="Jarvis.Win10.NeuralVoidPreview.DesktopShellSurface"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.NeuralVoidPreview"
    xmlns:System="clr-namespace:System;assembly=System.Runtime"
    Width="1600"
    Height="900"
    Background="#000000"
    Focusable="True"
    Loaded="Surface_OnLoaded"
    Unloaded="Surface_OnUnloaded"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <FontFamily x:Key="DisplayFont">./Assets/Fonts/#Barlow Condensed</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <SolidColorBrush x:Key="CanvasBrush" Color="#000000" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4EF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7A1" />
        <SolidColorBrush x:Key="PrimaryRuleBrush" Color="#C2C2BE" />
        <SolidColorBrush x:Key="SecondaryRuleBrush" Color="#626562" />
        <SolidColorBrush x:Key="QuietRuleBrush" Color="#303230" />

        <!-- State-lock tokens: one disabled opacity for every interactive family. -->
        <System:Double x:Key="DisabledOpacity">0.48</System:Double>

        <!-- Selection highlight is pure white across every interactive family. -->
        <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFFF" />

        <CollectionViewSource
            x:Key="LayoutDefinitionsView"
            Source="{x:Static local:LayoutCatalog.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PaneCount" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="FocusFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusFrame" Property="Background" Value="#090909" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=Root}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FocusFrame" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DesktopShortcutButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="170" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LayoutOptionItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="{x:Static local:DesktopShellSurface.LayoutItemHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding AutomationName}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#090909" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemFrame" Property="BorderBrush" Value="{Binding AccentBrush, ElementName=Root}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayoutRailListStyle" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer
                            Padding="0"
                            Focusable="False"
                            CanContentScroll="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsPresenter
                                Margin="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskbarButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="98" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FileRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource QuietRuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ExplorerSessionMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1" Padding="4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerSessionMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuFrame" Background="#000000" BorderBrush="Transparent" BorderThickness="1" Padding="12,9">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuFrame" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Canvas x:Name="DesktopCanvas" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
        <Canvas x:Name="DesktopIconList" Panel.ZIndex="1">
            <Button
                x:Name="ThisPcShortcutButton"
                Canvas.Left="198"
                Canvas.Top="104"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="THIS PC"
                AutomationProperties.Name="This PC">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <Viewbox Width="98" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="72" Height="72">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,3 L 68,3 L 68,54 L 4,54 Z M 10,64 L 62,64 M 25,54 L 25,67 M 47,54 L 47,67" />
                            <Rectangle Canvas.Left="60" Canvas.Top="9" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="THIS PC" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="104"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="PROJECTS"
                AutomationProperties.Name="Projects">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,9 L 28,9 L 35,16 L 70,16 L 70,55 L 4,55 Z" />
                            <Rectangle Canvas.Left="61" Canvas.Top="20" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="PROJECTS" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="198"
                Canvas.Top="300"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="TERMINAL"
                AutomationProperties.Name="Terminal">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="98" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="68" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,4 L 64,4 L 64,56 L 4,56 Z M 15,21 L 27,30 L 15,39 M 31,40 L 47,40" />
                            <Rectangle Canvas.Left="57" Canvas.Top="9" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="TERMINAL" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="300"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="ARCHIVE"
                AutomationProperties.Name="Archive">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 4,20 L 14,6 L 60,6 L 70,20 L 70,56 L 4,56 Z M 4,20 L 70,20 M 29,26 L 45,26 L 45,31 L 29,31 Z" />
                            <Rectangle Canvas.Left="33" Canvas.Top="36" Width="9" Height="7" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="ARCHIVE" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="198"
                Canvas.Top="494"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="NETWORK"
                AutomationProperties.Name="Network">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="72" Height="60">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 12,7 L 27,7 L 27,22 L 12,22 Z M 45,7 L 60,7 L 60,22 L 45,22 Z M 29,39 L 44,39 L 44,54 L 29,54 Z M 19,22 L 19,31 L 52,31 L 52,22 M 36,31 L 36,39" />
                            <Rectangle Canvas.Left="33" Canvas.Top="27" Width="6" Height="6" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="NETWORK" />
                </Grid>
            </Button>

            <Button
                Canvas.Left="382"
                Canvas.Top="494"
                Style="{StaticResource DesktopShortcutButton}"
                Click="DesktopShortcut_OnClick"
                CommandParameter="CONFIG"
                AutomationProperties.Name="Configuration">
                <Grid Width="126" Height="146">
                    <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                    <Viewbox Width="100" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="74" Height="66">
                            <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 37,3 L 66,20 L 66,46 L 37,63 L 8,46 L 8,20 Z M 37,14 L 56,25 L 56,41 L 37,52 L 18,41 L 18,25 Z" />
                            <Ellipse Canvas.Left="33" Canvas.Top="29" Width="8" Height="8" Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="17" Text="CONFIG" />
                </Grid>
            </Button>
        </Canvas>

        <Border
            x:Name="ExplorerWindow"
            Canvas.Left="596"
            Canvas.Top="63"
            Width="930"
            Height="667"
            Panel.ZIndex="5"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource PrimaryRuleBrush}"
            BorderThickness="2"
            PreviewMouseDown="OwnedWindow_OnPreviewMouseDown"
            GotKeyboardFocus="OwnedWindow_OnGotKeyboardFocus"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="ExplorerTitleBar"
                    Grid.Row="0"
                    BorderBrush="{StaticResource SecondaryRuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="ExplorerTitleBar_OnMouseLeftButtonDown"
                    MouseMove="ExplorerTitleBar_OnMouseMove"
                    MouseLeftButtonUp="ExplorerTitleBar_OnMouseLeftButtonUp"
                    LostMouseCapture="OwnedTitleBar_OnLostMouseCapture">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Path Width="19" Height="15" Margin="0,0,12,0" Stroke="{Binding AccentBrush, ElementName=Root}" StrokeThickness="1.5" Data="M 1,3 L 8,3 L 11,6 L 18,6 L 18,14 L 1,14 Z" />
                            <TextBlock
                                x:Name="ExplorerTitleText"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="15"
                                Text="JARVIS2 / FILE EXPLORER"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ExplorerMinimizeButton" Style="{StaticResource WindowControlButton}" Click="ExplorerMinimizeButton_OnClick" AutomationProperties.Name="Minimize Explorer">
                                <Path Width="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Data="M 0,1 L 16,1" />
                            </Button>
                            <Button x:Name="ExplorerMaximizeButton" Style="{StaticResource WindowControlButton}" Click="ExplorerMaximizeButton_OnClick" AutomationProperties.Name="Maximize Explorer">
                                <Rectangle Width="15" Height="15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" />
                            </Button>
                            <Button x:Name="ExplorerCloseButton" Style="{StaticResource WindowControlButton}" Click="ExplorerCloseButton_OnClick" AutomationProperties.Name="Close Explorer">
                                <Path Width="16" Height="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 1,1 L 15,15 M 15,1 L 1,15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <local:ExplorerSurface
                    x:Name="PrimaryExplorerSurface"
                    Grid.Row="1"
                    AccentBrush="{Binding AccentBrush, ElementName=Root}" />
            </Grid>
        </Border>

        <Border
            x:Name="TaskManagerWindow"
            Canvas.Left="720"
            Canvas.Top="104"
            Width="760"
            Height="600"
            Panel.ZIndex="7"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource PrimaryRuleBrush}"
            BorderThickness="2"
            Visibility="Collapsed"
            PreviewMouseDown="OwnedWindow_OnPreviewMouseDown"
            GotKeyboardFocus="OwnedWindow_OnGotKeyboardFocus"
            PreviewKeyDown="TaskManagerWindow_OnPreviewKeyDown"
            SnapsToDevicePixels="True"
            AutomationProperties.Name="JARVIS2 Task Manager window">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="TaskManagerTitleBar"
                    ClipToBounds="True"
                    Grid.Row="0"
                    BorderBrush="{StaticResource SecondaryRuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TaskManagerTitleBar_OnMouseLeftButtonDown"
                    MouseMove="TaskManagerTitleBar_OnMouseMove"
                    MouseLeftButtonUp="TaskManagerTitleBar_OnMouseLeftButtonUp"
                    LostMouseCapture="OwnedTitleBar_OnLostMouseCapture">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="19" Height="19" Margin="0,0,12,0">
                                <Rectangle Width="13" Height="13" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" />
                                <Rectangle Width="5" Height="5" Fill="{Binding AccentBrush, ElementName=Root}" />
                            </Grid>
                            <TextBlock x:Name="TaskManagerTitleText" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="JARVIS2 / TASK MANAGER" />
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" Text="OWNED / READ ONLY" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="TaskManagerMinimizeButton" Style="{StaticResource WindowControlButton}" Click="TaskManagerMinimizeButton_OnClick" AutomationProperties.Name="Minimize Task Manager">
                                <Path Width="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" Data="M 0,1 L 16,1" />
                            </Button>
                            <Button x:Name="TaskManagerMaximizeButton" Style="{StaticResource WindowControlButton}" Click="TaskManagerMaximizeButton_OnClick" AutomationProperties.Name="Maximize Task Manager">
                                <Rectangle Width="15" Height="15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" />
                            </Button>
                            <Button x:Name="TaskManagerCloseButton" Style="{StaticResource WindowControlButton}" Click="TaskManagerCloseButton_OnClick" AutomationProperties.Name="Close Task Manager">
                                <Path Width="16" Height="16" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 1,1 L 15,15 M 15,1 L 1,15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <local:TaskManagerSurface
                    x:Name="TaskManagerPanel"
                    Grid.Row="1"
                    AccentBrush="{Binding AccentBrush, ElementName=Root}" />
            </Grid>
        </Border>

        <Grid
            x:Name="LayoutRailHitRegion"
            Canvas.Left="0"
            Canvas.Top="0"
            Width="126"
            Height="800"
            Panel.ZIndex="20"
            Background="Transparent"
            PreviewMouseLeftButtonDown="LayoutRailRegion_OnPreviewMouseLeftButtonDown"
            MouseLeave="LayoutRailRegion_OnMouseLeave">
            <Border
                x:Name="LayoutAxisUpper"
                Width="2"
                Height="752"
                Margin="124,48,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{StaticResource PrimaryRuleBrush}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,1">
                <Border.RenderTransform><ScaleTransform x:Name="LayoutAxisScale" ScaleY="1" /></Border.RenderTransform>
            </Border>
            <Grid
                x:Name="LayoutRailPanel"
                Width="126"
                Height="660"
                Margin="0,70,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="1"
                Visibility="Visible">
                <Border
                    x:Name="LayoutRailViewport"
                    Width="86"
                    Height="{x:Static local:DesktopShellSurface.LayoutViewportHeight}"
                    Margin="20,52,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    ClipToBounds="True">
                    <ListBox
                        x:Name="LayoutRailList"
                        Width="86"
                        Height="{x:Static local:DesktopShellSurface.LayoutViewportHeight}"
                        Margin="0"
                        Padding="0"
                        Style="{StaticResource LayoutRailListStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Source={StaticResource LayoutDefinitionsView}}"
                        ItemContainerStyle="{StaticResource LayoutOptionItem}"
                        SelectedValuePath="Preset"
                        SelectionMode="Single"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="False"
                        PreviewMouseLeftButtonUp="LayoutRailPanel_OnPreviewMouseLeftButtonUp"
                        PreviewKeyDown="LayoutRailPanel_OnPreviewKeyDown"
                        PreviewMouseWheel="LayoutRailList_OnPreviewMouseWheel"
                        AutomationProperties.HelpText="The rail remains visible. Feathered edges indicate more layouts. Pointer distance above or below the rail center controls scroll speed; arrow keys, Home, End, and the wheel remain available.">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <!--
                                PERMANENT LAYOUT-AXIS INVARIANT:
                                GroupItem must add no horizontal chrome or indentation.
                                Every 70x42 rail glyph and CurrentLayoutGlyph must
                                occupy x=28..98 on the shared x=63 centerline.
                                -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel Margin="0">
                                                        <ContentPresenter
                                                            Margin="0"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                                        <ItemsPresenter Margin="0" />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Height="12" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LayoutDefinition}">
                                <local:LayoutGlyph
                                    Width="{x:Static local:DesktopShellSurface.LayoutGlyphWidth}"
                                    Height="{x:Static local:DesktopShellSurface.LayoutGlyphHeight}"
                                    IsHitTestVisible="False"
                                    Preset="{Binding Preset}"
                                    IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                        Stroke="{StaticResource TextBrush}"
                                                                        Accent="{StaticResource SelectionBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <Border
            x:Name="TaskbarChrome"
            Canvas.Left="0"
            Canvas.Top="800"
            Width="1600"
            Height="100"
            Panel.ZIndex="30"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource PrimaryRuleBrush}"
            BorderThickness="0,2,0,0">
            <Canvas>
                <Button
                    x:Name="CurrentLayoutButton"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="126"
                    Height="98"
                    Style="{StaticResource BareButton}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="CurrentLayoutButton_OnClick"
                    AutomationProperties.Name="Current multi-view layout">
                    <local:LayoutGlyph
                        x:Name="CurrentLayoutGlyph"
                        Width="{x:Static local:DesktopShellSurface.LayoutGlyphWidth}"
                        Height="{x:Static local:DesktopShellSurface.LayoutGlyphHeight}"
                        Preset="LeftMainRightStack"
                        IsFreeform="True"
                        Stroke="{StaticResource TextBrush}"
                                                Accent="{StaticResource SelectionBrush}"
                                                IsSelected="True" />
                </Button>

                <Button x:Name="TaskbarSearchButton" Canvas.Left="170" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="SEARCH" AutomationProperties.Name="Search">
                    <Viewbox Width="38" Height="38"><Canvas Width="38" Height="38"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="22" Height="22" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /><Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 22,22 L 36,36" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="TaskbarTaskViewButton" Canvas.Left="242" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="TASK VIEW" AutomationProperties.Name="Task view">
                    <Viewbox Width="38" Height="38"><Canvas Width="38" Height="38"><Rectangle Canvas.Left="3" Canvas.Top="7" Width="25" Height="25" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /><Rectangle Canvas.Left="9" Canvas.Top="3" Width="25" Height="25" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="TaskbarExplorerButton" Canvas.Left="314" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarExplorerButton_OnClick" AutomationProperties.Name="File Explorer">
                    <Grid Width="58" Height="98">
                        <Viewbox Width="38" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="38" Height="34"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 2,8 L 14,8 L 18,12 L 36,12 L 36,31 L 2,31 Z" /></Canvas></Viewbox>
                        <Border x:Name="ExplorerRunningIndicator" Height="3" Margin="5,0,5,5" VerticalAlignment="Bottom" Background="{Binding AccentBrush, ElementName=Root}" />
                    </Grid>
                </Button>
                <Button x:Name="TaskbarTerminalButton" Canvas.Left="386" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="TERMINAL" AutomationProperties.Name="Terminal">
                    <Viewbox Width="38" Height="34"><Canvas Width="38" Height="34"><Rectangle Canvas.Left="2" Canvas.Top="2" Width="34" Height="30" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /><Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 9,10 L 17,17 L 9,24 M 21,24 L 29,24" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="TaskbarSystemButton" Canvas.Left="458" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarSystemButton_OnClick" AutomationProperties.Name="Task Manager">
                    <Grid Width="58" Height="98">
                        <Viewbox Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="38" Height="38"><Rectangle Canvas.Left="8" Canvas.Top="8" Width="22" Height="22" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /><Rectangle Canvas.Left="13" Canvas.Top="13" Width="12" Height="12" Fill="{Binding AccentBrush, ElementName=Root}" /><Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Data="M 13,1 L 13,8 M 19,1 L 19,8 M 25,1 L 25,8 M 13,30 L 13,37 M 19,30 L 19,37 M 25,30 L 25,37 M 1,13 L 8,13 M 1,19 L 8,19 M 1,25 L 8,25 M 30,13 L 37,13 M 30,19 L 37,19 M 30,25 L 37,25" /></Canvas></Viewbox>
                        <Border x:Name="TaskManagerRunningIndicator" Height="3" Margin="5,0,5,5" VerticalAlignment="Bottom" Background="{Binding AccentBrush, ElementName=Root}" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="TaskbarNetworkButton" Canvas.Left="1250" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="NETWORK" AutomationProperties.Name="Network status">
                    <Viewbox Width="38" Height="32"><Canvas Width="38" Height="32"><Rectangle Canvas.Left="2" Canvas.Top="3" Width="29" Height="22" Stroke="{StaticResource TextBrush}" StrokeThickness="2" /><Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 11,25 L 11,30 M 22,25 L 22,30 M 7,30 L 26,30 M 6,8 L 6,19 M 6,8 L 14,8 M 6,13 L 12,13 M 6,19 L 14,19" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="TaskbarVolumeButton" Canvas.Left="1314" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="AUDIO" AutomationProperties.Name="Audio volume">
                    <Viewbox Width="36" Height="34"><Canvas Width="36" Height="34"><Path Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 3,13 L 10,13 L 19,5 L 19,29 L 10,21 L 3,21 Z M 24,11 C 29,14 29,20 24,23 M 28,7 C 36,13 36,21 28,27" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="TaskbarClockButton" Canvas.Left="1382" Canvas.Top="0" Width="142" Height="98" Style="{StaticResource BareButton}" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Click="TaskbarUtilityButton_OnClick" CommandParameter="CLOCK" AutomationProperties.Name="Clock">
                    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock x:Name="ClockTimeText" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="25" Text="--:--" />
                        <TextBlock x:Name="ClockDateText" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="15" Text="---- -- --" />
                    </StackPanel>
                </Button>
                <Button x:Name="TaskbarNotificationsButton" Canvas.Left="1530" Canvas.Top="0" Style="{StaticResource TaskbarButton}" Click="TaskbarUtilityButton_OnClick" CommandParameter="NOTIFICATIONS" AutomationProperties.Name="Notifications">
                    <Path Width="28" Height="27" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Data="M 2,2 L 26,2 L 26,22 L 17,22 L 12,27 L 12,22 L 2,22 Z" />
                </Button>
            </Canvas>
        </Border>

        <Border
            x:Name="LayoutAxisLower"
            Canvas.Left="124"
            Canvas.Top="800"
            Width="2"
            Height="100"
            Panel.ZIndex="50"
            IsHitTestVisible="False"
            Background="{StaticResource PrimaryRuleBrush}" />

        <TextBlock
            x:Name="InteractionStatusText"
            Canvas.Left="146"
            Canvas.Top="778"
            Panel.ZIndex="40"
            Foreground="{StaticResource SecondaryTextBrush}"
            FontFamily="{StaticResource MonoFont}"
            FontSize="10"
            Opacity="0"
            IsHitTestVisible="False"
            AutomationProperties.LiveSetting="Polite"
            Text="READY" />
    </Canvas>
</UserControl>

<UserControl
    x:Class="Jarvis.Win10.NeuralVoidPreview.NeuralVoidPreviewSurface"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.NeuralVoidPreview"
    Width="1600"
    Height="900"
    Background="#030809"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#030809" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#050B0D" />
        <SolidColorBrush x:Key="ElevatedBrush" Color="#071113" />
        <SolidColorBrush x:Key="LineBrush" Color="#0F2C27" />
        <SolidColorBrush x:Key="TextBrush" Color="#D7F8EC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E9187" />
        <SolidColorBrush x:Key="FaintBrush" Color="#36564E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="DesktopIcon" TargetType="Border">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="CommandCell" TargetType="Border">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#02000000" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FolderTile" TargetType="Border">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Background" Value="#04090B" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DesktopCanvas" ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush
                Center="0.68,0.44"
                GradientOrigin="0.68,0.44"
                RadiusX="0.78"
                RadiusY="0.92">
                <GradientStop Color="#071011" Offset="0" />
                <GradientStop Color="#030809" Offset="0.52" />
                <GradientStop Color="#010303" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <local:NeuralVectorLayer
            x:Name="VectorLayer"
            Panel.ZIndex="3"
            Opacity="0.9" />

        <Grid
            Panel.ZIndex="4"
            Margin="24,14,24,0"
            VerticalAlignment="Top"
            Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border
                    Width="28"
                    Height="28"
                    BorderBrush="{Binding AccentBrush, ElementName=Root}"
                    BorderThickness="2">
                    <Ellipse
                        Margin="6"
                        Stroke="{Binding AccentBrush, ElementName=Root}"
                        StrokeThickness="2" />
                </Border>
                <StackPanel Margin="13,0,0,0">
                    <TextBlock
                        Foreground="{Binding AccentBrush, ElementName=Root}"
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="JARVIS V2  //  NEURAL VOID" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource Mono}"
                        FontSize="9"
                        Text="WINDOWS 10 / LOCAL VISUAL FRAME / OWN PROCESS" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="0,0,9,0"
                    Fill="{Binding AccentBrush, ElementName=Root}" />
                <TextBlock
                    Foreground="{Binding AccentBrush, ElementName=Root}"
                    FontFamily="Consolas"
                    FontSize="10"
                    Text="VISUAL LINK NOMINAL" />
                <TextBlock
                    Margin="20,0,0,0"
                    Style="{StaticResource Mono}"
                    FontSize="10"
                    Text="{Binding AccentHex, ElementName=Root}" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="DesktopIconList"
            Panel.ZIndex="4"
            Margin="22,82,0,70"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Border Style="{StaticResource DesktopIcon}">
                <StackPanel HorizontalAlignment="Center">
                    <Border
                        Width="42"
                        Height="32"
                        Margin="0,4,0,7"
                        Background="#0A1719"
                        BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                        BorderThickness="2">
                        <Border
                            Width="26"
                            Height="15"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top"
                            Background="{Binding AccentFaintBrush, ElementName=Root}" />
                    </Border>
                    <TextBlock FontSize="11" Text="This PC" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DesktopIcon}">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse
                        Width="39"
                        Height="39"
                        Margin="0,1,0,5"
                        Stroke="{Binding AccentDimBrush, ElementName=Root}"
                        StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Color="{Binding AccentColor, ElementName=Root}"
                                Opacity="0.35"
                                ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock FontSize="11" Text="Network" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DesktopIcon}">
                <StackPanel HorizontalAlignment="Center">
                    <Border
                        Width="34"
                        Height="39"
                        Margin="0,1,0,5"
                        Background="#091315"
                        BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                        BorderThickness="1" />
                    <TextBlock FontSize="11" Text="Recycle Bin" />
                </StackPanel>
            </Border>
            <Border
                Style="{StaticResource DesktopIcon}"
                Background="{Binding AccentFaintBrush, ElementName=Root}"
                BorderBrush="{Binding AccentDimBrush, ElementName=Root}">
                <StackPanel HorizontalAlignment="Center">
                    <Border
                        Width="40"
                        Height="40"
                        Margin="0,2,0,4"
                        BorderBrush="{Binding AccentBrush, ElementName=Root}"
                        BorderThickness="1">
                        <Ellipse
                            Margin="8"
                            Stroke="{Binding AccentBrush, ElementName=Root}"
                            StrokeThickness="2" />
                    </Border>
                    <TextBlock FontSize="11" Text="Control Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border
            Panel.ZIndex="2"
            Margin="186,78,122,86"
            Background="#050B0D"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Color="{Binding AccentColor, ElementName=Root}"
                    Opacity="0.18"
                    ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="112" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid Background="#050B0D">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                            Width="24"
                            Height="24"
                            BorderBrush="{Binding AccentBrush, ElementName=Root}"
                            BorderThickness="1">
                            <Path
                                Margin="5"
                                Data="M 0,5 L 5,0 L 10,5 L 5,10 Z"
                                Fill="{Binding AccentBrush, ElementName=Root}" />
                        </Border>
                        <TextBlock
                            Margin="12,0,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Text="NEURAL FILE SYSTEM  //  THIS PC" />
                        <TextBlock
                            Margin="15,0,0,0"
                            Foreground="{Binding AccentBrush, ElementName=Root}"
                            FontFamily="Consolas"
                            FontSize="9"
                            Text="LOCAL FRAME" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock
                            Width="46"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            Text="—" />
                        <TextBlock
                            Width="46"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Text="□" />
                        <TextBlock
                            Width="46"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            Text="×" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="ExplorerCommandBar"
                    Grid.Row="1"
                    Background="{StaticResource ElevatedBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,1">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CommandCell}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path
                                        Width="22"
                                        Height="22"
                                        Data="M 1,11 L 11,1 L 21,11 L 11,21 Z"
                                        Fill="{Binding AccentDimBrush, ElementName=Root}" />
                                    <TextBlock Margin="0,7,0,0" FontSize="10" Text="Properties" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CommandCell}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontFamily="Consolas"
                                        FontSize="22"
                                        Text="↑" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Text="Open" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CommandCell}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontFamily="Consolas"
                                        FontSize="20"
                                        Text="⌁" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Text="Rename" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Margin="10,0" Background="{StaticResource LineBrush}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Style="{StaticResource CommandCell}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontFamily="Consolas"
                                        FontSize="20"
                                        Text="↯" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Text="Access" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CommandCell}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontFamily="Consolas"
                                        FontSize="20"
                                        Text="＋" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Text="New node" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="3" Margin="10,0" Background="{StaticResource LineBrush}" />

                        <StackPanel Grid.Column="4" Margin="14,0,0,0">
                            <TextBlock
                                Foreground="{Binding AccentBrush, ElementName=Root}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="NEURAL COMMAND BUS" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource Mono}"
                                Text="OWNED PREVIEW  /  SHELL MUTATION FALSE" />
                            <ProgressBar
                                Margin="0,12,40,0"
                                Height="3"
                                Maximum="100"
                                Value="68"
                                Background="#081012"
                                BorderThickness="0"
                                Foreground="{Binding AccentBrush, ElementName=Root}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Background="#050C0E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{Binding AccentBrush, ElementName=Root}"
                        FontSize="20"
                        Text="‹" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource MutedBrush}"
                        FontSize="20"
                        Text="›" />
                    <Border
                        Grid.Column="2"
                        Margin="0,6,8,6"
                        Padding="12,0"
                        Background="#071113"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="◈  THIS PC  /  NEURAL STORAGE" />
                    </Border>
                    <Border
                        Grid.Column="3"
                        Margin="0,6,12,6"
                        Padding="12,0"
                        Background="#071113"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource MutedBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="Search neural index" />
                    </Border>
                </Grid>

                <Grid x:Name="ExplorerContentHost" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="#050C0E"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,1,0">
                        <StackPanel Margin="0,14">
                            <TextBlock
                                Margin="14,0,0,9"
                                Style="{StaticResource Mono}"
                                FontSize="9"
                                Text="NEURAL TREE" />
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontSize="14"
                                        Text="✦" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="Quick access" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{Binding AccentBrush, ElementName=Root}" Text="▣" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="Desktop" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{Binding AccentBrush, ElementName=Root}" Text="↓" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="Downloads" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{Binding AccentBrush, ElementName=Root}" Text="▤" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="Documents" />
                                </StackPanel>
                            </Border>
                            <Border
                                Height="35"
                                Margin="0,12,0,0"
                                Padding="13,0"
                                Background="{Binding AccentFaintBrush, ElementName=Root}"
                                BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                                BorderThickness="0,1,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        FontSize="13"
                                        Text="◉" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="This PC" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="▰" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="NEURAL OS (C:)" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="▰" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="DATA STREAM (D:)" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="▰" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="ARCHIVE (E:)" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Foreground="{Binding AccentBrush, ElementName=Root}" Text="⌁" />
                                    <TextBlock Margin="10,0,0,0" FontSize="11" Text="Network" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid
                        x:Name="ExplorerFolderView"
                        Grid.Column="1"
                        Margin="22,18,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Foreground="{Binding AccentBrush, ElementName=Root}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="NEURAL NODES / 06" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    FontSize="18"
                                    FontWeight="Light"
                                    Text="Folders" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource Mono}"
                                Text="SIGNAL MAP  /  LOCAL" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                            <Border Style="{StaticResource FolderTile}">
                                <StackPanel>
                                    <Border
                                        Width="42"
                                        Height="31"
                                        HorizontalAlignment="Left"
                                        Background="{Binding AccentFaintBrush, ElementName=Root}"
                                        BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                                        BorderThickness="1" />
                                    <TextBlock Margin="0,13,0,0" FontSize="13" Text="Desktop" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Mono}" FontSize="9" Text="LOCAL SURFACE" />
                                </StackPanel>
                            </Border>
                            <Border
                                Width="200"
                                Height="112"
                                Margin="0,0,18,18"
                                Padding="15"
                                Background="#050C0E"
                                BorderBrush="{Binding AccentBrush, ElementName=Root}"
                                BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Color="{Binding AccentColor, ElementName=Root}"
                                        Opacity="0.18"
                                        ShadowDepth="0" />
                                </Border.Effect>
                                <Grid>
                                    <StackPanel>
                                        <Border
                                            Width="42"
                                            Height="31"
                                            HorizontalAlignment="Left"
                                            BorderBrush="{Binding AccentBrush, ElementName=Root}"
                                            BorderThickness="1">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding AccentBrush, ElementName=Root}"
                                                FontFamily="Consolas"
                                                Text="▤" />
                                        </Border>
                                        <TextBlock Margin="0,13,0,0" FontSize="13" Text="Documents" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{Binding AccentBrush, ElementName=Root}"
                                            FontFamily="Consolas"
                                            FontSize="9"
                                            Text="FOCUS LOCKED" />
                                    </StackPanel>
                                    <Path
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="18"
                                        Height="18"
                                        Data="M 0,18 L 0,0 L 18,0"
                                        Stroke="{Binding AccentBrush, ElementName=Root}"
                                        StrokeThickness="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource FolderTile}">
                                <StackPanel>
                                    <Border
                                        Width="42"
                                        Height="31"
                                        HorizontalAlignment="Left"
                                        Background="{Binding AccentFaintBrush, ElementName=Root}"
                                        BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                                        BorderThickness="1" />
                                    <TextBlock Margin="0,13,0,0" FontSize="13" Text="Downloads" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Mono}" FontSize="9" Text="TRANSFER NODE" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FolderTile}">
                                <StackPanel>
                                    <Border
                                        Width="42"
                                        Height="31"
                                        HorizontalAlignment="Left"
                                        Background="{Binding AccentFaintBrush, ElementName=Root}"
                                        BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                                        BorderThickness="1" />
                                    <TextBlock Margin="0,13,0,0" FontSize="13" Text="Pictures" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Mono}" FontSize="9" Text="VISUAL ARCHIVE" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border
                            Grid.Row="2"
                            Height="1"
                            Margin="0,0,0,14"
                            Background="{Binding AccentFaintBrush, ElementName=Root}" />

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{Binding AccentBrush, ElementName=Root}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="STORAGE CORES / 03" />
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="14"
                                    Background="#071113"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Text="NEURAL OS (C:)" />
                                        <ProgressBar
                                            Margin="0,12,0,0"
                                            Height="6"
                                            Maximum="100"
                                            Value="44"
                                            Background="#132326"
                                            BorderThickness="0"
                                            Foreground="{Binding AccentBrush, ElementName=Root}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Mono}" FontSize="9" Text="418 GB FREE / 930 GB" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="14"
                                    Background="#071113"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Text="DATA STREAM (D:)" />
                                        <ProgressBar
                                            Margin="0,12,0,0"
                                            Height="6"
                                            Maximum="100"
                                            Value="67"
                                            Background="#132326"
                                            BorderThickness="0"
                                            Foreground="{Binding AccentBrush, ElementName=Root}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Mono}" FontSize="9" Text="1.42 TB FREE / 2.72 TB" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="4"
                                    Padding="14"
                                    Background="#071113"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Text="ARCHIVE (E:)" />
                                        <ProgressBar
                                            Margin="0,12,0,0"
                                            Height="6"
                                            Maximum="100"
                                            Value="28"
                                            Background="#132326"
                                            BorderThickness="0"
                                            Foreground="{Binding AccentBrush, ElementName=Root}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Mono}" FontSize="9" Text="2.18 TB FREE / 7.27 TB" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" Background="#050B0D">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Mono}"
                        FontSize="9"
                        Text="08 NODES  /  01 SELECTED  /  LOCAL VISUAL MODEL" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{Binding AccentBrush, ElementName=Root}"
                        FontFamily="Consolas"
                        FontSize="9"
                        Text="SHELL LINK: OFFLINE" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Panel.ZIndex="4"
            Height="58"
            VerticalAlignment="Bottom"
            Background="#04090B"
            BorderBrush="{Binding AccentFaintBrush, ElementName=Root}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="TaskbarStartButton"
                    Width="62"
                    Background="{Binding AccentFaintBrush, ElementName=Root}"
                    BorderBrush="{Binding AccentDimBrush, ElementName=Root}"
                    BorderThickness="0,0,1,0">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{Binding AccentBrush, ElementName=Root}" />
                        <Rectangle
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Fill="{Binding AccentBrush, ElementName=Root}" />
                        <Rectangle
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Fill="{Binding AccentBrush, ElementName=Root}" />
                        <Rectangle
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="{Binding AccentBrush, ElementName=Root}" />
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="TaskbarTaskList"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Border Width="60" Background="#050B0D">
                        <Ellipse
                            Width="20"
                            Height="20"
                            Stroke="{StaticResource TextBrush}"
                            StrokeThickness="2" />
                    </Border>
                    <Border Width="60" Background="#050B0D">
                        <Border
                            Width="25"
                            Height="20"
                            BorderBrush="{StaticResource TextBrush}"
                            BorderThickness="2" />
                    </Border>
                    <Border Width="66" Background="#0A1719">
                        <Grid>
                            <Border
                                Width="28"
                                Height="22"
                                Background="{Binding AccentDimBrush, ElementName=Root}"
                                BorderBrush="{Binding AccentBrush, ElementName=Root}"
                                BorderThickness="1" />
                            <Border
                                Height="3"
                                VerticalAlignment="Bottom"
                                Background="{Binding AccentBrush, ElementName=Root}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Color="{Binding AccentColor, ElementName=Root}"
                                        Opacity="0.8"
                                        ShadowDepth="0" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Width="60" Background="#050B0D">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding AccentBrush, ElementName=Root}"
                            FontFamily="Consolas"
                            FontSize="20"
                            Text="⌬" />
                    </Border>
                    <Border Width="60" Background="#050B0D">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextBrush}"
                            FontFamily="Consolas"
                            FontSize="18"
                            Text="⚙" />
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="TaskbarNotificationArea"
                    Grid.Column="2"
                    Margin="0,0,18,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{Binding AccentBrush, ElementName=Root}"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="⌃" />
                    <TextBlock
                        Margin="18,0,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="◫  ◖  ⌁" />
                    <Border
                        Margin="18,0,0,0"
                        Padding="12,0,0,0"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1,0,0,0">
                        <StackPanel x:Name="TaskbarClock">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{Binding AccentBrush, ElementName=Root}"
                                FontFamily="Consolas"
                                FontSize="12"
                                Text="14:39" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                FontFamily="Consolas"
                                FontSize="9"
                                Text="2026.07.30" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

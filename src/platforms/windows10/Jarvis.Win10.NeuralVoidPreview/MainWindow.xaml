<Window
    x:Class="Jarvis.Win10.NeuralVoidPreview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.NeuralVoidPreview"
    Title="JARVIS2 / Horizon Membrane"
    Width="1600"
    Height="900"
    MinWidth="1180"
    MinHeight="664"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#000000"
    KeyDown="Window_OnKeyDown"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <local:DesktopShellSurface
        x:Name="PreviewSurface"
        HorizontalAlignment="Left"
        VerticalAlignment="Top" />
</Window>

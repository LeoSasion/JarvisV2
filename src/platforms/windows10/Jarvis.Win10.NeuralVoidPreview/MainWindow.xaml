<Window
    x:Class="Jarvis.Win10.NeuralVoidPreview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Jarvis.Win10.NeuralVoidPreview"
    Title="JARVIS V2 · Neural Void owned preview"
    Width="1480"
    Height="900"
    MinWidth="1180"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResizeWithGrip"
    Background="#030809"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#071113" />
        <SolidColorBrush x:Key="LineBrush" Color="#183B35" />
        <SolidColorBrush x:Key="TextBrush" Color="#D7F8EC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E9187" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0A1719" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border
            Padding="20,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Foreground="#00FF9A"
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="OWN-PROCESS VISUAL PREVIEW" />
                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource PresetButton}"
                            Tag="186.117647"
                            Click="PresetButton_OnClick"
                            Content="A / CYAN" />
                        <Button
                            Style="{StaticResource PresetButton}"
                            Tag="24.941176"
                            Click="PresetButton_OnClick"
                            Content="C / AMBER" />
                        <Button
                            Style="{StaticResource PresetButton}"
                            Tag="156.235294"
                            Click="PresetButton_OnClick"
                            Content="D / EMERALD" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{StaticResource MutedBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="ACCENT HUE / 0—360°" />
                        <TextBlock
                            x:Name="HueValue"
                            Grid.Column="1"
                            Foreground="#00FF9A"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="156.2°" />
                    </Grid>
                    <Slider
                        x:Name="HueSlider"
                        Margin="0,12,0,0"
                        Minimum="0"
                        Maximum="359.999"
                        Value="156.235294"
                        ValueChanged="HueSlider_OnValueChanged" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock
                        Foreground="{StaticResource MutedBrush}"
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="LOCAL EFFECT" />
                    <ComboBox
                        x:Name="EffectSelector"
                        Margin="0,9,0,0"
                        Height="32"
                        Padding="8,0"
                        Background="#0A1719"
                        BorderBrush="{StaticResource LineBrush}"
                        Foreground="{StaticResource TextBrush}"
                        SelectionChanged="EffectSelector_OnSelectionChanged">
                        <ComboBoxItem Tag="static" Content="STATIC" />
                        <ComboBoxItem Tag="breathe" Content="BREATHE" />
                        <ComboBoxItem Tag="spectrum" Content="SPECTRUM" />
                        <ComboBoxItem Tag="signal-pulse" IsSelected="True" Content="SIGNAL PULSE" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock
                        Foreground="#00FF9A"
                        FontFamily="Consolas"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        Text="DESKTOP CONTENT = NEURAL VOID" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        FontFamily="Consolas"
                        FontSize="9"
                        HorizontalAlignment="Right"
                        Text="SHELL / DEVICE I/O / ACTIVATION = FALSE" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#010304" Padding="16">
            <Viewbox Stretch="Uniform">
                <local:NeuralVoidPreviewSurface
                    x:Name="PreviewSurface"
                    Width="1600"
                    Height="900" />
            </Viewbox>
        </Border>

        <Grid Grid.Row="2" Background="#050B0D">
            <TextBlock
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource MutedBrush}"
                FontFamily="Consolas"
                FontSize="9"
                Text="THIS WINDOW RENDERS A SIMULATED DESKTOP IN THIS PROCESS ONLY" />
            <TextBlock
                x:Name="FrameStatus"
                Margin="0,0,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="#00FF9A"
                FontFamily="Consolas"
                FontSize="9"
                Text="#00FF9A / SIGNAL-PULSE" />
        </Grid>
    </Grid>
</Window>

<UserControl
    x:Class="Jarvis.Win10.NeuralVoidPreview.TaskManagerSurface"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000"
    ClipToBounds="True"
    Focusable="True"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <!-- THESIS: one glance proves this is bounded read-only telemetry, not a clone of Task Manager or a process-control surface. -->
    <!-- OWN-WORLD: pure black planes, white measurement type, gray rules, square geometry, and one inherited yellow state signal. -->
    <!-- STORY: the operator sees system load, scans a stable process ledger, and can leave without any destructive action. -->
    <!-- FIRST VIEWPORT: aggregate CPU and memory lead above one dense five-column process ledger; no card grid or ornamental chart competes. -->
    <!-- FORM: an incumbent-world local extension in Operate mode; the signature interaction is sampling that stops exactly when its owned window leaves view. -->
    <!-- FINISH: deterministic behavior receipts land now; a valid connected-session pixel review still gates visual publication. -->

    <UserControl.Resources>
        <FontFamily x:Key="DisplayFont">./Assets/Fonts/#Barlow Condensed</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4EF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7A7A1" />
        <SolidColorBrush x:Key="SecondaryRuleBrush" Color="#626562" />
        <SolidColorBrush x:Key="QuietRuleBrush" Color="#303230" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFFF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="ProcessRow" TargetType="ListBoxItem">
            <Setter Property="Height" Value="43" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="RowFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource QuietRuleBrush}"
                                BorderThickness="0,0,0,1">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border
                                x:Name="SelectionRail"
                                Width="2"
                                HorizontalAlignment="Left"
                                Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowFrame" Property="Background" Value="#0B0B09" />
                                <Setter TargetName="SelectionRail" Property="Background" Value="{StaticResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CompactProcessRowTemplate">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="11"
                    Foreground="{StaticResource TextBrush}"
                    Text="{Binding ProcessName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding ProcessIdText}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="10"
                    Foreground="{StaticResource TextBrush}"
                    Text="{Binding CpuPercentText}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ProcessScrollThumb" TargetType="Thumb">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="{StaticResource SecondaryRuleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding AccentBrush, ElementName=Root}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track
                                x:Name="PART_Track"
                                Focusable="False"
                                IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ProcessScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SummaryRow" Height="126" />
            <RowDefinition Height="43" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="40" />
        </Grid.RowDefinitions>

        <Border x:Name="SummaryPanel" Grid.Row="0" BorderBrush="{StaticResource SecondaryRuleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="VISIBLE PROCESS CPU" />
                    <TextBlock
                        x:Name="CpuSummaryText"
                        Margin="0,1,0,0"
                        FontFamily="{StaticResource DisplayFont}"
                        FontSize="42"
                        FontWeight="Medium"
                        Text="LEARNING" />
                    <Rectangle
                        Width="76"
                        Height="2"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Fill="{Binding AccentBrush, ElementName=Root}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="VISIBLE WORKING SET" />
                    <TextBlock
                        x:Name="MemorySummaryText"
                        Margin="0,1,0,0"
                        FontFamily="{StaticResource DisplayFont}"
                        FontSize="42"
                        FontWeight="Medium"
                        Text="0 MB" />
                    <TextBlock
                        x:Name="ProcessCountText"
                        Margin="0,4,0,0"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="0 VISIBLE / 0 ENUMERATED" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Rectangle
                            x:Name="SamplingStateMarker"
                            Width="6"
                            Height="6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            x:Name="SamplingStateText"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Text="PAUSED" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CapturedAtText"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="NO SAMPLE" />
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="PROCESS CONTROL ABSENT" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource SecondaryRuleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid x:Name="FullProcessHeader" Margin="24,0,34,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="126" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="PROCESS" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="PID" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="MEMORY" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="THREADS" />
                </Grid>
                <TextBlock x:Name="CompactSamplingStateText" Margin="100,0,190,0" VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding Text, ElementName=SamplingStateText}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <Grid x:Name="CompactProcessHeader" Margin="14,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="PROCESS" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="PID" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="CPU" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox
                x:Name="ProcessList"
                ItemsSource="{Binding ProcessRows, ElementName=Root}"
                ItemContainerStyle="{StaticResource ProcessRow}"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.Name="Read-only process telemetry">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ProcessScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="24,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ProcessIdText}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextBrush}" Text="{Binding CpuPercentText}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextBrush}" Text="{Binding WorkingSetText}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ThreadCountText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Rectangle Width="30" Height="30" Stroke="{StaticResource SecondaryRuleBrush}" StrokeThickness="1" />
                <TextBlock
                    Margin="0,13,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="WAITING FOR FIRST SAMPLE" />
            </StackPanel>
        </Grid>

        <Border x:Name="StatusPanel" Grid.Row="3" BorderBrush="{StaticResource SecondaryRuleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ReadStatusText"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="NO PROCESS DATA READ" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="10"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="1 S REFRESH / 64 ROW LIMIT" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

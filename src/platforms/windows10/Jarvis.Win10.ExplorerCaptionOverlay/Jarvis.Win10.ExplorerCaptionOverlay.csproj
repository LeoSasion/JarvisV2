<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-win10-explorer-caption-overlay</AssemblyName>
    <RootNamespace>Jarvis.Win10.ExplorerCaptionOverlay</RootNamespace>
    <StartupObject>Jarvis.Win10.ExplorerCaptionOverlay.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Jarvis.Win10.ExplorerCaptionPlan\Jarvis.Win10.ExplorerCaptionPlan.csproj" />
  </ItemGroup>
</Project>

<Window
    x:Class="Jarvis.Win10.ExplorerCaptionOverlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JARVIS owned Explorer caption overlay"
    Height="32"
    Width="900"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">

    <Border Background="#F4070C10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="7"
                        Height="7"
                        Margin="0,0,9,0"
                        Background="#00F0A0"
                        CornerRadius="4" />
                    <TextBlock
                        Foreground="#DDF8F1"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="JARVIS // 10" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Foreground="#71928C"
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="EXPLORER" />
                    <TextBlock
                        Margin="9,0"
                        Foreground="#2C514A"
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="/" />
                    <TextBlock
                        Foreground="#A7C7C0"
                        FontFamily="Consolas"
                        FontSize="10"
                        Text="NEURAL VOID LINK" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#76928C"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Text="&#xE921;" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#76928C"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Text="&#xE922;" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#D4E5E1"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Text="&#xE8BB;" />
                </Grid>
            </Grid>

            <Rectangle Grid.Row="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#001B1715" />
                        <GradientStop Offset="0.18" Color="#00F0A0" />
                        <GradientStop Offset="0.55" Color="#16B8D4" />
                        <GradientStop Offset="0.86" Color="#F0B958" />
                        <GradientStop Offset="1" Color="#001B1715" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Border>
</Window>

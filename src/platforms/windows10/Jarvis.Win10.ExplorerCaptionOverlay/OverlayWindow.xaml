<Window
    x:Class="Jarvis.Win10.ExplorerCaptionOverlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JARVIS owned Explorer caption overlay"
    Height="32"
    Width="900"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">

    <Border Background="#F4070C10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        Stretch="Uniform">
                        <Grid Width="14" Height="14">
                            <Path
                                Data="M 7,1.5 L 12.5,11.5 L 1.5,11.5 Z"
                                Fill="Transparent"
                                Stroke="#00F0C8"
                                StrokeThickness="2">
                                <Path.Effect>
                                    <BlurEffect Radius="4" />
                                </Path.Effect>
                            </Path>
                            <Path
                                Data="M 7,1.5 L 12.5,11.5 L 1.5,11.5 Z"
                                Fill="#1600F0C8"
                                Stroke="#8EFFF0"
                                StrokeThickness="1" />
                        </Grid>
                    </Viewbox>

                    <TextBlock
                        Grid.Column="1"
                        Foreground="#DDF8F1"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="JARVIS / EXPLORER"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Path
                        Width="88"
                        Height="8"
                        Data="M 0,4 L 26,4 L 32,1 L 38,7 L 44,4 L 88,4"
                        Stretch="Fill"
                        Stroke="#245E59"
                        StrokeThickness="1" />
                    <TextBlock
                        Margin="100,0,0,0"
                        Foreground="#71928C"
                        FontFamily="Consolas"
                        FontSize="9"
                        Text="NEURAL LINK" />
                </Grid>

                <TextBlock
                    x:Name="RemainingTimeText"
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#63817C"
                    FontFamily="Consolas"
                    FontSize="9"
                    Text="CANARY 00:00" />
            </Grid>

            <Rectangle
                Grid.Row="1"
                Fill="#00BFA5"
                Opacity="0.62" />
        </Grid>
    </Border>
</Window>

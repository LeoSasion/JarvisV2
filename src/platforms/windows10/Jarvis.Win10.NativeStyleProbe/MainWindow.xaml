<Window
    x:Class="Jarvis.Win10.NativeStyleProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JARVIS V2 · Windows 10 Native Style Probe"
    Width="1120"
    Height="740"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResizeWithGrip"
    Background="#070B0E"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0C1318" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#101B21" />
        <SolidColorBrush x:Key="LineBrush" Color="#243943" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7EFF1" />
        <SolidColorBrush x:Key="MutedBrush" Color="#82959D" />
        <SolidColorBrush x:Key="FaintBrush" Color="#53666E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00FF9A" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B958" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="MonoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#132128" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style
            x:Key="RgbButton"
            BasedOn="{StaticResource PresetButton}"
            TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ClientSurface" Background="#070B0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="AccentRail"
            Grid.Column="0"
            Background="{DynamicResource AccentBrush}" />

        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource AccentBrush}"
                        FontFamily="Consolas"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Text="WINDOWS 10 / EXACT HOST / OWNED HWND" />
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="30"
                        FontWeight="Light"
                        Text="Native style probe" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        FontSize="12"
                        Text="Real Win10 DWM caption behavior, applied only to this process." />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="14,9"
                    VerticalAlignment="Top"
                    Background="#15302F"
                    BorderBrush="#2E6E69"
                    BorderThickness="1"
                    CornerRadius="3">
                    <StackPanel>
                        <TextBlock
                            Foreground="{DynamicResource AccentBrush}"
                            FontFamily="Consolas"
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Text="OWN PROCESS ONLY" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="#8EB7B4"
                            FontFamily="Consolas"
                            FontSize="9"
                            HorizontalAlignment="Center"
                            Text="EXPLORER UNTOUCHED" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,24,0,0"
                Padding="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MonoLabel}" Text="CAPTION PRESET" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button
                                Style="{StaticResource PresetButton}"
                                Tag="JarvisGraphite"
                                Click="PresetButton_OnClick"
                                Content="JARVIS GRAPHITE" />
                            <Button
                                Style="{StaticResource PresetButton}"
                                Tag="NativeAccent"
                                Click="PresetButton_OnClick"
                                Content="NATIVE ACCENT" />
                            <Button
                                Style="{StaticResource PresetButton}"
                                Tag="SystemDefault"
                                Click="PresetButton_OnClick"
                                Content="SYSTEM CAPTION" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource MonoLabel}"
                                Text="NEURAL VOID RGB FRAME" />
                            <TextBlock
                                x:Name="RgbHueValue"
                                Grid.Column="1"
                                Foreground="{DynamicResource AccentBrush}"
                                FontFamily="Consolas"
                                FontSize="10"
                                Text="156.2°" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <Button
                                    Style="{StaticResource RgbButton}"
                                    Tag="186.117647"
                                    Click="RgbPresetButton_OnClick"
                                    Content="A" />
                                <Button
                                    Style="{StaticResource RgbButton}"
                                    Tag="24.941176"
                                    Click="RgbPresetButton_OnClick"
                                    Content="C" />
                                <Button
                                    Style="{StaticResource RgbButton}"
                                    Tag="156.235294"
                                    Click="RgbPresetButton_OnClick"
                                    Content="D" />
                            </WrapPanel>
                            <ComboBox
                                x:Name="RgbEffectSelector"
                                Grid.Column="2"
                                Width="112"
                                Height="30"
                                SelectedIndex="3"
                                SelectionChanged="RgbEffectSelector_OnSelectionChanged">
                                <ComboBoxItem Tag="static" Content="STATIC" />
                                <ComboBoxItem Tag="breathe" Content="BREATHE" />
                                <ComboBoxItem Tag="spectrum" Content="SPECTRUM" />
                                <ComboBoxItem Tag="signal-pulse" Content="SIGNAL" />
                            </ComboBox>
                            <Slider
                                x:Name="RgbHueSlider"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,6,0,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="360"
                                Value="156.235294"
                                ValueChanged="RgbHueSlider_OnValueChanged" />
                        </Grid>
                        <TextBlock
                            x:Name="RgbFrameStatus"
                            Margin="0,5,0,0"
                            Foreground="{DynamicResource AccentBrush}"
                            FontFamily="Consolas"
                            FontSize="9"
                            Text="#00FF9A / SIGNAL-PULSE / CLIENT ONLY" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Margin="24,0,0,0"
                        Padding="15,11"
                        VerticalAlignment="Center"
                        Background="#0A1115"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabel}" Text="ACTIVE CALL" />
                            <TextBlock
                                x:Name="CallStatus"
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource AccentBrush}"
                                FontFamily="Consolas"
                                FontSize="12"
                                Text="WAITING FOR HWND" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabel}" Text="EXACT HOST ADMISSION" />
                            <TextBlock
                                x:Name="ProfileName"
                                Margin="0,9,0,0"
                                FontSize="21"
                                FontWeight="Light" />
                            <TextBlock
                                x:Name="HostSummary"
                                Margin="0,6,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                FontFamily="Consolas"
                                FontSize="11" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            Height="1"
                            Background="{StaticResource LineBrush}" />

                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MonoLabel}" Text="DWM COMPOSITION" />
                                <TextBlock
                                    x:Name="CompositionStatus"
                                    Margin="0,7,0,0"
                                    FontSize="15" />
                                <TextBlock
                                    x:Name="HighContrastStatus"
                                    Margin="0,18,0,0"
                                    Style="{StaticResource MonoLabel}" />
                                <TextBlock
                                    x:Name="AnimationStatus"
                                    Margin="0,7,0,0"
                                    Style="{StaticResource MonoLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MonoLabel}" Text="SYSTEM COLORIZATION" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="ColorizationSwatch"
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" />
                                    <TextBlock
                                        x:Name="ColorizationValue"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12" />
                                </Grid>
                                <TextBlock
                                    x:Name="OpaqueBlendStatus"
                                    Margin="0,13,0,0"
                                    Style="{StaticResource MonoLabel}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="22"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MonoLabel}" Text="PLATFORM CONTRACT" />
                        <TextBlock
                            x:Name="PresetName"
                            Margin="0,9,0,0"
                            FontSize="21"
                            FontWeight="Light"
                            Text="JARVIS GRAPHITE" />
                        <TextBlock
                            x:Name="PresetDescription"
                            Margin="0,8,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="Shared Jarvis visual intent translated to the one reviewed Win10 caption attribute." />

                        <Border
                            Margin="0,20,0,0"
                            Padding="14"
                            Background="#0A1115"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MonoLabel}" Text="BOUNDARY" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Text="HWND = THIS WINDOW" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Foreground="{StaticResource MutedBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="EXPLORER MUTATION = FALSE" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource MutedBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="WINDHAWK = NOT USED" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource MutedBrush}"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Text="LIVE EXPLORER = NOT-RUN" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Padding="14,11"
                Background="#0A1115"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="{StaticResource MutedBrush}"
                        FontFamily="Consolas"
                        FontSize="9"
                        Text="CLOSE THIS WINDOW TO RELEASE ALL OWNED-HWND STYLE STATE" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{StaticResource AmberBrush}"
                        FontFamily="Consolas"
                        FontSize="9"
                        Text="WIN10 BACKEND · SLICE 01" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

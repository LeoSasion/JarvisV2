<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-win10-rgb-theme-model</AssemblyName>
    <RootNamespace>Jarvis.Win10.RgbThemeModel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\..\config\windows10-neural-void-rgb-theme.json"
      Link="windows10-neural-void-rgb-theme.json"
      LogicalName="Jarvis.Win10.RgbThemeModel.neural-void-theme.json" />
  </ItemGroup>
</Project>

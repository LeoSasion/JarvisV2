<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-win10-rgb-theme-model</AssemblyName>
    <RootNamespace>Jarvis.Win10.RgbThemeModel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\..\common\Jarvis.VisualEffects\Jarvis.VisualEffects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\..\config\windows10-neural-void-rgb-theme.json"
      Link="windows10-neural-void-rgb-theme.json"
      LogicalName="Jarvis.Win10.RgbThemeModel.neural-void-theme.json" />
    <EmbeddedResource
      Include="..\..\..\..\config\neural-void-global-vfx-contract.json"
      Link="neural-void-global-vfx-contract.json"
      LogicalName="Jarvis.Win10.RgbThemeModel.global-vfx-contract.json" />
    <EmbeddedResource
      Include="..\..\..\..\config\neural-void-vfx-preset.json"
      Link="neural-void-vfx-preset.json"
      LogicalName="Jarvis.Win10.RgbThemeModel.vfx-preset.json" />
  </ItemGroup>
</Project>

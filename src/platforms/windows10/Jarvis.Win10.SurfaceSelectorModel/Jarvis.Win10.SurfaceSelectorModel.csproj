<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-win10-surface-selector-model</AssemblyName>
    <RootNamespace>Jarvis.Win10.SurfaceSelectorModel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\..\config\windows10-surface-selector-candidate.json"
      Link="windows10-surface-selector-candidate.json"
      LogicalName="Jarvis.Win10.SurfaceSelectorModel.selector-candidate.json" />
    <EmbeddedResource
      Include="..\..\..\..\tests\native\windows10\fixtures\win10-22h2-19045.6466-shell-selector-evidence.json"
      Link="win10-22h2-19045.6466-shell-selector-evidence.json"
      LogicalName="Jarvis.Win10.SurfaceSelectorModel.topology-evidence.json" />
  </ItemGroup>
</Project>

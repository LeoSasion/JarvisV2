    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>jarvis-explorer-host-model</AssemblyName>
    <RootNamespace>Jarvis.ExplorerHostModel</RootNamespace>
  </PropertyGroup>

</Project>

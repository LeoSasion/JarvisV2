{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvisv2.local/schemas/windows10-host-profiles.schema.json",
  "title": "JarvisV2 Windows 10 exact host profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "platform": {
      "const": "windows10"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "status",
        "displayVersion",
        "build",
        "ubr",
        "architecture",
        "installationType",
        "explorer",
        "allowedCapabilities",
        "activationPermitted",
        "liveExplorer",
        "boundedCaptionObservation"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^win10-[a-z0-9.-]+-x64$"
        },
        "status": {
          "const": "observed-caption-write-disabled-owned-overlay-visually-verified"
        },
        "displayVersion": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "integer",
          "minimum": 10240,
          "maximum": 21999
        },
        "ubr": {
          "type": "integer",
          "minimum": 0
        },
        "architecture": {
          "const": "X64"
        },
        "installationType": {
          "const": "Client"
        },
        "explorer": {
          "$ref": "#/$defs/explorer"
        },
        "allowedCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "read-system-dwm-state",
              "read-shell-window-topology",
              "read-single-explorer-caption-state",
              "run-bounded-owned-explorer-caption-overlay-preview",
              "run-bounded-owned-taskbar-edge-overlay-preview",
              "run-bounded-single-explorer-dark-caption-preview",
              "set-owned-window-dark-caption",
              "run-bounded-desktop-text-color-preview"
            ]
          },
          "uniqueItems": true
        },
        "activationPermitted": {
          "const": false
        },
        "liveExplorer": {
          "const": "not-run"
        },
        "boundedCaptionObservation": {
          "$ref": "#/$defs/boundedCaptionObservation"
        }
      }
    },
    "boundedCaptionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "result",
        "observedAtUtc",
        "visualVerificationPassed",
        "titleBarDifferentPixels",
        "titleBarPixelCount",
        "targetRetiredBeforeRollback",
        "explorerProcessStable",
        "rollbackVerified",
        "appsUseLightTheme",
        "executionCapabilityEnabled"
      ],
      "properties": {
        "runId": {
          "const": "20260731T084924086Z-608182a4"
        },
        "result": {
          "const": "api-readback-and-refresh-passed-rollback-verified-visual-diff-failed-light-app-theme"
        },
        "observedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "visualVerificationPassed": {
          "const": false
        },
        "titleBarDifferentPixels": {
          "const": 0
        },
        "titleBarPixelCount": {
          "const": 36448
        },
        "targetRetiredBeforeRollback": {
          "const": false
        },
        "explorerProcessStable": {
          "const": true
        },
        "rollbackVerified": {
          "const": true
        },
        "appsUseLightTheme": {
          "const": 1
        },
        "executionCapabilityEnabled": {
          "const": false
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productVersion",
        "fileVersion",
        "size",
        "sha256"
      ],
      "properties": {
        "productVersion": {
          "type": "string",
          "minLength": 1
        },
        "fileVersion": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    }
  }
}

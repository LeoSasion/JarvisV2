        "liveExplorer": {
          "const": "not-run"
        },
        "mutationPerformed": {
          "const": true
        },
        "stopRequired": {
          "const": false
        },
        "detail": {
          "$ref": "#/$defs/startDetail"
        }
      }
    },
    "enablePassed": {
      "properties": {
        "action": {
          "const": "EnableOnce"
        },
        "result": {
          "const": "passed-one-shot-m2-active"
        },
        "liveExplorer": {
          "const": "controlled-session"
        },
        "mutationPerformed": {
          "const": true
        },
        "stopRequired": {
          "const": false
        },
        "detail": {
          "$ref": "#/$defs/enableDetail"
        }
      }
    },
    "observePassed": {
      "properties": {
        "action": {
          "const": "Observe"
        },
        "result": {
          "const": "passed-bounded-idle-observation"
        },
        "liveExplorer": {
          "const": "controlled-session"
        },
        "mutationPerformed": {
          "const": false
        },
        "stopRequired": {
          "const": false
        },
        "detail": {
          "$ref": "#/$defs/observeDetail"
        }
      }
    },
    "recoverZeroMappings": {
      "properties": {
        "action": {
          "const": "Recover"
        },
        "result": {
          "const": "passed-locked-zero-mappings"
        },
        "liveExplorer": {
          "const": "controlled-session"
        },
        "mutationPerformed": {
          "const": true
        },
        "stopRequired": {
          "const": false
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/recoverDetail"
            },
            {
              "properties": {
                "errors": {
                  "maxItems": 0
                },
                "explorerProcessIdStable": {
                  "const": true
                },
                "targetDisabled": {
                  "const": true
                },
                "serviceState": {
                  "const": "Stopped"
                },
                "serviceStartMode": {
                  "const": "Manual"
                },
                "serviceProcessId": {
                  "const": 0
                },
                "killSwitchArmed": {
                  "const": true
                },
                "permitPresent": {
                  "const": false
                },
                "targetExplorerMappingCount": {
                  "const": 0
                },
                "allWindhawkAndJarvisMappings": {
                  "maxItems": 0
                }
              }
            }
          ]
        }
      }
    },
    "recoverRuntimeResidual": {
      "properties": {
        "action": {
          "const": "Recover"
        },
        "result": {
          "const": "passed-locked-runtime-residual-recorded"
        },
        "liveExplorer": {
          "const": "controlled-session"
        },
        "mutationPerformed": {
          "const": true
        },
        "stopRequired": {
          "const": false
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/recoverDetail"
            },
            {
              "properties": {
                "errors": {
                  "maxItems": 0
                },
                "explorerProcessIdStable": {
                  "const": true
                },
                "targetDisabled": {
                  "const": true
                },
                "serviceState": {
                  "const": "Stopped"
                },
                "serviceStartMode": {
                  "const": "Manual"
                },
                "serviceProcessId": {
                  "const": 0
                },
                "killSwitchArmed": {
                  "const": true
                },
                "permitPresent": {
                  "const": false
                },
                "targetExplorerMappingCount": {
                  "const": 0
                },
                "allWindhawkAndJarvisMappings": {
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/windhawkBaseMapping"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "recoverNeedsAttention": {
      "properties": {
        "action": {
          "const": "Recover"
        },
        "result": {
          "const": "failed-locked-state-needs-attention"
        },
        "liveExplorer": {
          "const": "controlled-session"
        },
        "mutationPerformed": {
          "const": true
        },
        "stopRequired": {
          "const": true
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/recoverDetail"
            },
            {
              "properties": {
                "errors": {
                  "minItems": 1

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvisv2.local/schemas/pi-agent-desktop-host-contract.schema.json",
  "title": "JarvisV2 Pi Agent desktop host contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "upstream",
    "runtime",
    "transport",
    "session",
    "desktopProvider",
    "tools",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "jarvisv2-pi-agent-desktop-host-v1"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "exactVersion",
        "repository",
        "documentation",
        "license"
      ],
      "properties": {
        "package": {
          "const": "@earendil-works/pi-coding-agent"
        },
        "exactVersion": {
          "const": "0.82.1"
        },
        "repository": {
          "const": "https://github.com/earendil-works/pi"
        },
        "documentation": {
          "const": "https://pi.dev/docs/latest/sdk"
        },
        "license": {
          "const": "MIT"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeMinimumMajor",
        "integrationMode",
        "sdkImportModel",
        "launchState",
        "piOfflineRequired",
        "sessionCreationEnabled",
        "desktopLaunchImplemented"
      ],
      "properties": {
        "nodeMinimumMajor": {
          "const": 22
        },
        "integrationMode": {
          "const": "sdk-sidecar-jsonl"
        },
        "sdkImportModel": {
          "const": "pinned-package-core-module-adapter"
        },
        "launchState": {
          "const": "review-gated-workspace-session-admission"
        },
        "piOfflineRequired": {
          "const": true
        },
        "sessionCreationEnabled": {
          "const": true
        },
        "desktopLaunchImplemented": {
          "const": true
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "encoding",
        "maxFrameBytes",
        "requestTypes",
        "credentialFieldsAllowed"
      ],
      "properties": {
        "framing": {
          "const": "lf-delimited-jsonl"
        },
        "encoding": {
          "const": "utf-8"
        },
        "maxFrameBytes": {
          "const": 65536
        },
        "requestTypes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "hello"
            },
            {
              "const": "capabilities"
            },
            {
              "const": "start_session"
            },
            {
              "const": "start_turn"
            },
            {
              "const": "abort_turn"
            },
            {
              "const": "commit_workspace_edit"
            },
            {
              "const": "discard_workspace_edit"
            },
            {
              "const": "shutdown"
            }
          ],
          "items": false
        },
        "credentialFieldsAllowed": {
          "const": false
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "promptingEnabled",
        "modelAuthentication",
        "modelTransport",
        "modelBrokerProtocol",
        "modelBrokerLifetime",
        "modelBrokerMaxFrameBytes",
        "modelBrokerMaxConcurrentConnections",
        "desktopTurnEventStream",
        "desktopTurnEventBufferCapacity",
        "desktopTurnEventBackpressurePolicy",
        "desktopConversationStateModel",
        "desktopConversationRetainedTurns",
        "desktopConversationMaxAssistantCharacters",
        "desktopConversationNotificationDispatch",
        "desktopConversationCheckpoint",
        "desktopConversationCheckpointMaxTurns",
        "desktopConversationCheckpointMaxBytes",
        "desktopConversationCheckpointMaxTextBytes",
        "desktopConversationCheckpointPersistence",
        "desktopConversationCheckpointStore",
        "desktopConversationCheckpointStoreRoot",
        "desktopConversationCheckpointEnvelopeMaxBytes",
        "desktopConversationCheckpointSave",
        "desktopConversationCheckpointSaveTimeoutMilliseconds",
        "desktopConversationCheckpointFailure",
        "reviewedIterationEnabled",
        "reviewedIterationPolicy",
        "reviewedIterationContinuation",
        "reviewedIterationStore",
        "reviewedIterationStoreRoot",
        "reviewedIterationEnvelopeMaxBytes",
        "reviewedIterationValidationProfile",
        "reviewedIterationRepositoryBaseline",
        "reviewedIterationRestart",
        "reviewedIterationWorkspaceCodeExecution",
        "desktopRuntimeOwnership",
        "desktopRuntimeShutdown",
        "credentialTransport",
        "persistence",
        "workspaceBinding",
        "resourceDiscovery",
        "modelNetworkAllowed"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "promptingEnabled": {
          "const": "desktop-broker-required"
        },
        "modelAuthentication": {
          "const": "desktop-process-only"
        },
        "modelTransport": {
          "const": "local-named-pipe"
        },
        "modelBrokerProtocol": {
          "const": "jarvisv2-pi-model-broker-v1"
        },
        "modelBrokerLifetime": {
          "const": "desktop-owned-multi-request"
        },
        "modelBrokerMaxFrameBytes": {
          "const": 1048576
        },
        "modelBrokerMaxConcurrentConnections": {
          "const": 4
        },
        "desktopTurnEventStream": {
          "const": "bounded-ordered-single-consumer"
        },
        "desktopTurnEventBufferCapacity": {
          "const": 512
        },
        "desktopTurnEventBackpressurePolicy": {
          "const": "fail-closed-at-request-timeout"
        },
        "desktopConversationStateModel": {
          "const": "immutable-revisioned-single-active-turn"
        },
        "desktopConversationRetainedTurns": {
          "const": 128
        },
        "desktopConversationMaxAssistantCharacters": {
          "const": 262144
        },
        "desktopConversationNotificationDispatch": {
          "const": "captured-synchronization-context"
        },
        "desktopConversationCheckpoint": {
          "const": "bounded-completed-text-context-restore"
        },
        "desktopConversationCheckpointMaxTurns": {
          "const": 32
        },
        "desktopConversationCheckpointMaxBytes": {
          "const": 32768
        },
        "desktopConversationCheckpointMaxTextBytes": {
          "const": 16384
        },
        "desktopConversationCheckpointPersistence": {
          "const": "desktop-owned-external"
        },
        "desktopConversationCheckpointStore": {
          "const": "current-user-dpapi-atomic-workspace-bound"
        },
        "desktopConversationCheckpointStoreRoot": {
          "const": "local-appdata-jarvis2-pi-agent-conversations"
        },
        "desktopConversationCheckpointEnvelopeMaxBytes": {
          "const": 65536
        },
        "desktopConversationCheckpointSave": {
          "const": "ordered-terminal-autosave-and-shutdown-flush"
        },
        "desktopConversationCheckpointSaveTimeoutMilliseconds": {
          "const": 5000
        },
        "desktopConversationCheckpointFailure": {
          "const": "close-submissions-and-surface-on-shutdown"
        },
        "reviewedIterationEnabled": {
          "const": true
        },
        "reviewedIterationPolicy": {
          "const": "desktop-owner-fixed-four-edits-six-hours"
        },
        "reviewedIterationContinuation": {
          "const": "automatic-after-owner-approval-and-passed-repository-gate"
        },
        "reviewedIterationStore": {
          "const": "current-user-dpapi-atomic-workspace-bound-durable-receipts"
        },
        "reviewedIterationStoreRoot": {
          "const": "local-appdata-jarvis2-pi-agent-reviewed-iterations"
        },
        "reviewedIterationEnvelopeMaxBytes": {
          "const": 262144
        },
        "reviewedIterationValidationProfile": {
          "const": "git-head-pathset-diffcheck-structured-parse-v1"
        },
        "reviewedIterationRepositoryBaseline": {
          "const": "clean-git-head-required"
        },
        "reviewedIterationRestart": {
          "const": "interrupted-explicit-rearm-no-proposal-restore"
        },
        "reviewedIterationWorkspaceCodeExecution": {
          "const": false
        },
        "desktopRuntimeOwnership": {
          "const": "desktop-owned-broker-sidecar-session-conversation"
        },
        "desktopRuntimeShutdown": {
          "const": "quiesce-cancel-checkpoint-flush-sidecar-shutdown-broker-dispose"
        },
        "credentialTransport": {
          "const": "forbidden"
        },
        "persistence": {
          "const": "in-memory"
        },
        "workspaceBinding": {
          "const": "single-explicit-root"
        },
        "resourceDiscovery": {
          "const": "disabled"
        },
        "modelNetworkAllowed": {
          "const": false
        }
      }
    },
    "desktopProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "implementation",
        "endpoint",
        "model",
        "reasoningEffort",
        "streaming",
        "responseStorage",
        "networkOwner",
        "credentialStore",
        "credentialRoot",
        "ambientCredentialAllowed",
        "credentialTransportToSidecar"
      ],
      "properties": {
        "mode": {
          "const": "opt-in"
        },
        "implementation": {
          "const": "openai-responses-api"
        },
        "endpoint": {
          "const": "https://api.openai.com/v1/responses"
        },
        "model": {
          "const": "gpt-5.6-sol"
        },
        "reasoningEffort": {
          "const": "medium"
        },
        "streaming": {
          "const": "server-sent-events"
        },
        "responseStorage": {
          "const": false
        },
        "networkOwner": {
          "const": "desktop-process-only"
        },
        "credentialStore": {
          "const": "current-user-dpapi-atomic"
        },
        "credentialRoot": {
          "const": "local-appdata-jarvis2-credentials"
        },
        "ambientCredentialAllowed": {
          "const": false
        },
        "credentialTransportToSidecar": {
          "const": false
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialAllowlist",
        "initiallyDenied",
        "proposalTool",
        "proposalMaxFileBytes",
        "proposalMaxSegmentBytes",
        "pendingProposalLimit",
        "pendingProposalPolicy",
        "approvalOwner",
        "approvalMode",
        "commitMode",
        "newFileSupported",
        "deleteSupported",
        "mutationGrant",
        "reviewedSelfIteration",
        "automaticReasoningContinuation",
        "unattendedApproval",
        "selfAuthoredPolicy",
        "unattendedSelfIteration"
      ],
      "properties": {
        "initialAllowlist": {
          "const": [
            "read",
            "grep",
            "find",
            "ls",
            "propose_edit"
          ]
        },
        "initiallyDenied": {
          "const": [
            "bash",
            "edit",
            "write"
          ]
        },
        "proposalTool": {
          "const": "non-mutating-existing-utf8-exact-replacement"
        },
        "proposalMaxFileBytes": {
          "const": 1048576
        },
        "proposalMaxSegmentBytes": {
          "const": 4096
        },
        "pendingProposalLimit": {
          "const": 1
        },
        "pendingProposalPolicy": {
          "const": "blocks-new-turns-and-clears-on-shutdown"
        },
        "approvalOwner": {
          "const": "desktop-user-only"
        },
        "approvalMode": {
          "const": "one-shot-exact-before-sha256"
        },
        "commitMode": {
          "const": "same-directory-atomic-replace-and-post-verify"
        },
        "newFileSupported": {
          "const": false
        },
        "deleteSupported": {
          "const": false
        },
        "mutationGrant": {
          "const": "desktop-owner-one-shot-existing-text-edit"
        },
        "reviewedSelfIteration": {
          "const": true
        },
        "automaticReasoningContinuation": {
          "const": true
        },
        "unattendedApproval": {
          "const": false
        },
        "selfAuthoredPolicy": {
          "const": false
        },
        "unattendedSelfIteration": {
          "const": false
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shellMutationSupported",
        "explorerMutationSupported",
        "systemMutationSupported",
        "deviceIntegrationSupported",
        "activationPermitted",
        "liveExplorer"
      ],
      "properties": {
        "shellMutationSupported": {
          "const": false
        },
        "explorerMutationSupported": {
          "const": false
        },
        "systemMutationSupported": {
          "const": false
        },
        "deviceIntegrationSupported": {
          "const": false
        },
        "activationPermitted": {
          "const": false
        },
        "liveExplorer": {
          "const": "not-run"
        }
      }
    }
  }
}

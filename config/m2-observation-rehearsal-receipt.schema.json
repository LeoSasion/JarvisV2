{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisV2 M2 locked observation rehearsal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "runId",
    "observedAtUtc",
    "result",
    "mode",
    "faultInjection",
    "faultInjected",
    "stopRequired",
    "stopReasons",
    "activationPermitted",
    "liveExplorer",
    "mutationPerformed",
    "sessionPlan",
    "actualHost",
    "evaluationState",
    "baseline",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "receiptType": {
      "const": "jarvisv2-m2-observation-rehearsal"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{9}Z-[a-f0-9]{8}$"
    },
    "observedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "passed",
        "stop-required",
        "failed"
      ]
    },
    "mode": {
      "const": "locked-rehearsal"
    },
    "faultInjection": {
      "enum": [
        "none",
        "kill-switch-missing",
        "permit-present",
        "windhawk-running",
        "explorer-changed",
        "module-mapped",
        "elevated-cpu"
      ]
    },
    "faultInjected": {
      "type": "boolean"
    },
    "stopRequired": {
      "type": "boolean"
    },
    "stopReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "activationPermitted": {
      "const": false
    },
    "liveExplorer": {
      "const": "not-run"
    },
    "mutationPerformed": {
      "const": false
    },
    "sessionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "runId",
        "sha256"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    },
    "actualHost": {
      "$ref": "#/$defs/hostState"
    },
    "evaluationState": {
      "$ref": "#/$defs/hostState"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "sampleCount",
        "averageCpuPercent",
        "peakCpuPercent",
        "peakPrivateMemoryBytes",
        "peakHandleCount",
        "peakThreadCount"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "averageCpuPercent": {
          "type": "number",
          "minimum": 0
        },
        "peakCpuPercent": {
          "type": "number",
          "minimum": 0
        },
        "peakPrivateMemoryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "peakHandleCount": {
          "type": "integer",
          "minimum": 0
        },
        "peakThreadCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "hostState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "killSwitchState",
        "permitState",
        "windhawkState",
        "windhawkStartMode",
        "explorerProcessId",
        "moduleMappingCount",
        "explorerModuleInspectionSucceeded"
      ],
      "properties": {
        "killSwitchState": {
          "type": "string",
          "minLength": 1
        },
        "permitState": {
          "type": "string",
          "minLength": 1
        },
        "windhawkState": {
          "type": "string",
          "minLength": 1
        },
        "windhawkStartMode": {
          "type": "string",
          "minLength": 1
        },
        "explorerProcessId": {
          "type": "integer",
          "minimum": 1
        },
        "moduleMappingCount": {
          "type": "integer",
          "minimum": 0
        },
        "explorerModuleInspectionSucceeded": {
          "type": "boolean"
        }
      }
    }
  }
}

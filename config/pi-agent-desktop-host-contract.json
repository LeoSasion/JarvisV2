{
  "schemaVersion": 1,
  "contractId": "jarvisv2-pi-agent-desktop-host-v1",
  "upstream": {
    "package": "@earendil-works/pi-coding-agent",
    "exactVersion": "0.82.1",
    "repository": "https://github.com/earendil-works/pi",
    "documentation": "https://pi.dev/docs/latest/sdk",
    "license": "MIT"
  },
  "runtime": {
    "nodeMinimumMajor": 22,
    "integrationMode": "sdk-sidecar-jsonl",
    "sdkImportModel": "pinned-package-core-module-adapter",
    "launchState": "read-only-session-admission",
    "piOfflineRequired": true,
    "sessionCreationEnabled": true,
    "desktopLaunchImplemented": true
  },
  "transport": {
    "framing": "lf-delimited-jsonl",
    "encoding": "utf-8",
    "maxFrameBytes": 65536,
    "requestTypes": [
      "hello",
      "capabilities",
      "start_session",
      "start_turn",
      "abort_turn",
      "shutdown"
    ],
    "credentialFieldsAllowed": false
  },
  "session": {
    "enabled": true,
    "promptingEnabled": "desktop-broker-required",
    "modelAuthentication": "desktop-process-only",
    "modelTransport": "local-named-pipe",
    "modelBrokerProtocol": "jarvisv2-pi-model-broker-v1",
    "modelBrokerLifetime": "desktop-owned-multi-request",
    "modelBrokerMaxFrameBytes": 1048576,
    "modelBrokerMaxConcurrentConnections": 4,
    "desktopTurnEventStream": "bounded-ordered-single-consumer",
    "desktopTurnEventBufferCapacity": 512,
    "desktopTurnEventBackpressurePolicy": "fail-closed-at-request-timeout",
    "desktopConversationStateModel": "immutable-revisioned-single-active-turn",
    "desktopConversationRetainedTurns": 128,
    "desktopConversationMaxAssistantCharacters": 262144,
    "desktopConversationNotificationDispatch": "captured-synchronization-context",
    "desktopConversationCheckpoint": "bounded-completed-text-context-restore",
    "desktopConversationCheckpointMaxTurns": 32,
    "desktopConversationCheckpointMaxBytes": 32768,
    "desktopConversationCheckpointMaxTextBytes": 16384,
    "desktopConversationCheckpointPersistence": "desktop-owned-external",
    "desktopConversationCheckpointStore": "current-user-dpapi-atomic-workspace-bound",
    "desktopConversationCheckpointStoreRoot": "local-appdata-jarvis2-pi-agent-conversations",
    "desktopConversationCheckpointEnvelopeMaxBytes": 65536,
    "desktopConversationCheckpointSave": "ordered-terminal-autosave-and-shutdown-flush",
    "desktopConversationCheckpointSaveTimeoutMilliseconds": 5000,
    "desktopConversationCheckpointFailure": "close-submissions-and-surface-on-shutdown",
    "desktopRuntimeOwnership": "desktop-owned-broker-sidecar-session-conversation",
    "desktopRuntimeShutdown": "quiesce-cancel-checkpoint-flush-sidecar-shutdown-broker-dispose",
    "credentialTransport": "forbidden",
    "persistence": "in-memory",
    "workspaceBinding": "single-explicit-root",
    "resourceDiscovery": "disabled",
    "modelNetworkAllowed": false
  },
  "desktopProvider": {
    "mode": "opt-in",
    "implementation": "openai-responses-api",
    "endpoint": "https://api.openai.com/v1/responses",
    "model": "gpt-5.6-sol",
    "reasoningEffort": "medium",
    "streaming": "server-sent-events",
    "responseStorage": false,
    "networkOwner": "desktop-process-only",
    "credentialStore": "current-user-dpapi-atomic",
    "credentialRoot": "local-appdata-jarvis2-credentials",
    "ambientCredentialAllowed": false,
    "credentialTransportToSidecar": false
  },
  "tools": {
    "initialAllowlist": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "initiallyDenied": [
      "bash",
      "edit",
      "write"
    ],
    "mutationGrant": "future-per-session-supervisor-capability",
    "unattendedSelfIteration": false
  },
  "boundaries": {
    "shellMutationSupported": false,
    "explorerMutationSupported": false,
    "systemMutationSupported": false,
    "deviceIntegrationSupported": false,
    "activationPermitted": false,
    "liveExplorer": "not-run"
  }
}
